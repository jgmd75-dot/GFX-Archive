gi_ = 0; loop(67, gu_ = 20 * 1000 ^ (gi_ / 66) / slider5; gm_ = 1 / sqrt(sqr(1 - gu_ * gu_) + sqr(gk2_ * gu_));
  gxx_ = 218 + gi_ * 2; gyy_ = 562 - 20 * log10(max(gm_, 0.001)) * 1.1; gyy_ = min(max(gyy_, 520), 596);
  gi_ > 0 ? ( ui_col(S57_INK); s57_ln(gpx_, gpy_, gxx_, gyy_, 1.5); ); gpx_ = gxx_; gpy_ = gyy_; gi_ += 1; );
// the envelope
