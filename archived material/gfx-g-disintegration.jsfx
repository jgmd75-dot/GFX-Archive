  ui_cola(0xFFFFFF, 0.5); s57_r(cx - 16, cy - 9.5, 32, 1.5);
  ui_cola(S57_INK, 0.15); s57_r(cx - 16, cy - 6, 32, 1); s57_r(cx - 16, cy + 5, 32, 1);
  ui_col(S57_IDX); s57_r(cx - 16, cy - 1, 32, 2);
  (hov || drag_id == did) ? ( sprintf(#s57_vv, "%.0f%%", v); s57_pill(cx, y0 + h + 10, #s57_vv); );
);
// the display's X for a position on the journey (0 .. 1), across the three zones
function dg_jx(p) ( p < 1 / 3 ? 40 + p * 3 * 316 : p < 2 / 3 ? 384 + (p - 1 / 3) * 3 * 432 : 848 + (p - 2 / 3) * 3 * 312; );
function dg_jy(t) ( 200 - min(max(t, 0), 1) * 80; );

// ---------- the header ----------
ui_col(S57_INK); s57_r(0, 52, 1200, 2);
pk_pextra = "Reset all to defaults";
gk_ = pk_preset(20 * sc, 10 * sc, 370 * sc, 34 * sc, pr_cur, #de_pm);
gk_ > 0 ? ( gk_ == 13 ? ( load_preset(1); gi_ = 38; loop(12, slider(gi_) = DZDEF[gi_ - 1]; ui_auto(gi_); gi_ += 1; ); pr_cur = 13; ) : load_preset(gk_); );
gfx_setfont(14); ui_col(S57_INK); s57_tc(604, 27, "DISINTEGRATION ENGINE");
