ge_ = 2.1 - 1.8 * slider2 / 100;
gi_ = 0; loop(8,
  gxx_ = 222 + gi_ * 16; gh_ = 58 * (gi_ + 1) ^ (-ge_);
  gi_ < slider1 ? ( ui_col(S57_INK); s57_r(gxx_, 372 - gh_, 10, gh_); ) : ( ui_cola(S57_INK, 0.35); s57_r(gxx_, 372 - gh_, 10, 1); s57_r(gxx_, 372 - gh_, 1, gh_); s57_r(gxx_ + 9, 372 - gh_, 1, gh_); );
