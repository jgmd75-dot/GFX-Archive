gi_ = 0; loop(8, ui_col(gi_ == gc_ ? S57_ORNG : S57_FACEX); gfx_circle((224 + gi_ * 16) * sc, 446 * sc, 4.5 * sc, 1, 1);
  ui_cola(S57_INK, 0.5); gfx_circle((224 + gi_ * 16) * sc, 446 * sc, 4.5 * sc, 0, 1); gi_ += 1; );
gdv_ = slider34 >= 0.5 ? 3 : 2; gc2_ = floor(gc_ / gdv_);
gi_ = 0; loop(ceil(8 / gdv_), gxx_ = 220 + gi_ * 16 * gdv_; ui_col(gi_ == gc2_ ? S57_INK : S57_FACEX); s57_rr(gxx_, 482, min(16 * gdv_ - 4, 352 - gxx_), 8, 3); gi_ += 1; );
// the clean filter
