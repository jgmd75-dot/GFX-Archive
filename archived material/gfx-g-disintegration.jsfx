// ---------- the display: the journey across the three columns ----------
ui_col(S57_INK); s57_rr(20, 58, 1160, 208, 5);
ui_col(DE_GLASS); s57_rr(24, 62, 1152, 200, 3);
ui_cola(DE_GGRID, 0.9); gi_ = 1; loop(47, s57_r(24 + gi_ * 24, 64, 1, 196); gi_ += 1; ); gi_ = 1; loop(8, s57_r(26, 62 + gi_ * 24, 1148, 1); gi_ += 1; );
// the zones, their names (the one the sound is in, lit)
gz_ = de_jx < 1 / 3 ? 0 : de_jx < 2 / 3 ? 1 : 2;
ui_cola(DE_GDIM, 0.8); gi_ = 0; loop(24, s57_r(368, 70 + gi_ * 8, 1, 4); s57_r(832, 70 + gi_ * 8, 1, 4); gi_ += 1; );
gfx_setfont(13);
ui_col(gz_ == 0 ? S57_ORNGL : DE_GDIM); s57_tc(196, 76, "INTEGRATION");
ui_col(gz_ == 1 ? S57_ORNGL : DE_GDIM); s57_tc(600, 76, "DISINTEGRATION");
ui_col(gz_ == 2 ? S57_ORNGL : DE_GDIM); s57_tc(1004, 76, "SECONDARY INTEGRATION");
// the journey's course as the controls set it (ADJUST travels it), faint
slider36 > 0 ? (
  gw_ = min(slider36 / 100 * 1.5, 1); gd_ = min(slider30 / 100 + de_cc1, 1);
  gi_ = 0; loop(61, gu_ = gi_ / 60;
    grr_ = slider31 / 100 * ((1 - gw_) + gw_ * de_eR(gu_)); gs_ = gd_ * ((1 - gw_) + gw_ * de_eD(gu_));
    gxx_ = dg_jx(0.15 + 0.35 * min(gs_ / max(gd_, 0.25), 1) * (1 - grr_) + 0.7 * min(grr_ / max(slider31 / 100, 0.2), 1) ^ 0.6); gyy_ = dg_jy(min(gs_ * (1 - 0.8 * grr_) * 1.25, 1));
    gi_ & 1 && gi_ > 0 ? ( ui_cola(DE_GINK, 0.18); s57_ln(gpx_, gpy_, gxx_, gyy_, 1); );
    gpx_ = gxx_; gpy_ = gyy_; gi_ += 1; );
);
// the trail: where the sound has been (a point when it has moved, or now and then)
gmx_ = dg_jx(de_jx); gmy_ = dg_jy(de_jy);
gt_ = time_precise();
(abs(gmx_ - dg_lx) + abs(gmy_ - dg_ly) > 2.5 || gt_ - dg_tt > 0.25) ? (
  dg_ti = (dg_ti + 1) % 200; DZTR[dg_ti * 2] = gmx_; DZTR[dg_ti * 2 + 1] = gmy_; dg_tn = min(dg_tn + 1, 200);
  dg_lx = gmx_; dg_ly = gmy_; dg_tt = gt_;
);
gi_ = 1; loop(dg_tn - 1,
  gj_ = (dg_ti - dg_tn + 1 + gi_ + 400) % 200; gk_ = (gj_ + 199) % 200;
  ui_cola(DE_GINK, 0.06 + 0.7 * (gi_ / dg_tn) ^ 1.5); s57_ln(DZTR[gk_ * 2], DZTR[gk_ * 2 + 1], DZTR[gj_ * 2], DZTR[gj_ * 2 + 1], 1.6);
  gi_ += 1; );
// the marker, the five forces as rays from it
gi_ = 0; loop(5,
  ga_ = (160 - gi_ * 35) * $pi / 180; gln_ = 10 + 22 * min(DZF[gi_] * 1.6, 1);
  ui_cola(S57_ORNGL, 0.25 + 0.6 * min(DZF[gi_] * 2, 1)); s57_ln(gmx_ + cos(ga_) * 9, gmy_ - sin(ga_) * 9, gmx_ + cos(ga_) * gln_, gmy_ - sin(ga_) * gln_, 1.6);
  gfx_circle((gmx_ + cos(ga_) * gln_) * sc, (gmy_ - sin(ga_) * gln_) * sc, 2.2 * sc, 1, 1);
  gi_ += 1; );
ui_cola(DE_GINK, 0.25); gfx_circle(gmx_ * sc, gmy_ * sc, 11 * sc, 1, 1);
ui_col(S57_ORNG); gfx_circle(gmx_ * sc, gmy_ * sc, 6 * sc, 1, 1);
ui_col(DE_GINK); gfx_circle(gmx_ * sc, gmy_ * sc, 2.2 * sc, 1, 1);
// the floor: the partials now (left), the five forces (centre), the journey (right)
