  gi_ == 0 ? ( s57_knob(714, gyy_ + 36, 13, 13, 0, 100, 40, 0, "RESTLESS", "%.0f%%", 0); s57_knob(784, gyy_ + 36, 13, 14, 0, 100, 30, 0, "JITTER", "%.0f%%", 0); ) :
