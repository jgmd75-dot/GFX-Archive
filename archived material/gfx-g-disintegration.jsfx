ui_cola(DE_GGRID, 1); s57_r(852, 240, 150, 6); ui_col(slider36 > 0 ? DE_GINK : DE_GDIM); s57_r(852, 240, 150 * de_phi, 6);
sprintf(#t_, slider36 > 0 ? "%.0f%%" : "HELD", de_phi * 100); ui_col(DE_GINK); s57_t(1010, 236, #t_);
