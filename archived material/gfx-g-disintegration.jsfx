gm_ = 0; loop(3, s57_key(860 + gm_ * 70, 16, 66, 22, slider39 == gm_, gm_ == 0 ? "POLY" : gm_ == 1 ? "MONO" : "LEGATO") ? s57_set(39, gm_); gm_ += 1; );
s57_knob(1090, 28, 12, 40, 0, 100, 0, 0, "", "GLIDE %.0f%%", 0);
