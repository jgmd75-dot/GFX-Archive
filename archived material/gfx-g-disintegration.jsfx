gi_ = 1; loop(10, gxx_ = 120 + 232 * log(gi_) / log(10); ui_cola(DE_GDIM, 0.5); s57_r(gxx_, 244, 1, 8); gi_ += 1; );
gv_ >= 0 ? (
  gq_ = DZV + gv_ * DZVS; gi_ = 0;
  loop(8, gu_ = gq_[64 + gi_]; ga_ = gq_[48 + gi_] / max(DZA[0], 0.0001);
    ga_ > 0.01 && gu_ >= 1 && gu_ <= 10.5 ? ( gxx_ = 120 + 232 * log(gu_) / log(10); ui_cola(S57_ORNGL, 0.4 + 0.6 * min(ga_, 1)); s57_r(gxx_ - 1, 252 - 30 * min(ga_, 1) - 2, 2.2, 30 * min(ga_, 1) + 2); );
    gi_ += 1; );
) : ( ui_col(DE_GDIM); s57_t(180, 232, "(PLAY A NOTE)"); );
// the forces' bars
gi_ = 0; loop(5,
  gxx_ = 404 + gi_ * 84; ui_col(DE_GDIM); s57_t(gxx_, 220, gi_ == 0 ? "PSYCHO" : gi_ == 1 ? "SENSUAL" : gi_ == 2 ? "INTELL" : gi_ == 3 ? "IMAGIN" : "EMOTION");
