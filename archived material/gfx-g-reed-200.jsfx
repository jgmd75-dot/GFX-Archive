  mg_lx = mg_px; mg_ly = mg_py; mg_i += 1;
);
mg_px = mg_cx + mg_off * mg_zs; mg_py = mg_base - (mk_flux(mg_off, 0, mk_d0) / mk_flux(0, 0, mk_d0)) * (mg_wh - 36);
ui_col(mg_acc); mg_r(mg_px - 0.75, mg_wy + 4, 1.5, mg_wh - 26);
