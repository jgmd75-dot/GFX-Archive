s92_key(152, 260, 56, 24, slider2 >= 0.5, slider2 >= 0.5 ? "ON" : "OFF") ? s92_set(2, slider2 >= 0.5 ? 0 : 1);
in_grd > 0.5 ? pk_led(220 * sc, 272 * sc, 3.5 * sc, 1, S92_RED); in_grd = 0;

// ---------- HIGH: the valve exciter (ANALOG) / the spectral enhancer (DIGITAL) ----------
s92_mod(254, 62, 270, 292, k9g_d ? "HF ENHANCER" : "VALVE EXCITER");
s92_onoff(444, 64, 11);
sprintf(#k9g_l, "TUNE  %.2f kHz", slider4 / 1000);
