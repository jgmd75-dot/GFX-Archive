s92_smallc(635, 330, k9g_d ? "NO ADDED HARMONICS" : "VALVE ON THE LOWS");

// ---------- OUTPUT: WARMTH / ALIGN, DRIFT, SAT; MIX and OUTPUT on faders ----------
s92_mod(746, 62, 194, 292, "OUTPUT");
s92_knob(788, 118, 18, 6, 0, 100, 30, 0, k9g_d ? "ALIGN" : "WARMTH", "%.0f%%", 0);
