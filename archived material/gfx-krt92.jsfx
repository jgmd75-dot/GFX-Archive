s92_kc = S92_C_HF;
s92_knob(326, 190, 32, 4, 1500, 8000, 3500, 1, "TUNE", "%.0f Hz", 0);
s92_knob(452, 190, 32, 3, 0, 100, 40, 0, "AMOUNT", "%.0f%%", 0);
s92_kc = 0;
s92_smallc(389, 266, "LISTEN");
s92_lc = S92_C_HF; s92_key(355, 276, 68, 24, slider13 >= 0.5, "SOLO") ? s92_set(13, slider13 >= 0.5 ? 0 : 1); s92_lc = 0;
s92_smallc(389, 330, k9g_d ? "UPWARD EXPANSION ABOVE TUNE" : "VALVE HARMONICS ABOVE TUNE");

// ---------- BASS: the bass contour (ANALOG) / low punch (DIGITAL) ----------
s92_mod(536, 62, 198, 292, k9g_d ? "LOW PUNCH" : "BASS CONTOUR");
s92_onoff(654, 64, 12);
s92_lcd(552, 94, 166, 26, k9g_d ? "XOVER 120 Hz" : "BELOW 100 Hz");
