);
a4_l *= a4_mt; a4_r *= a4_mt;
// OB: the console bus
!a4_mod ? ( a4_l = a4cL.a4_cb(a4_l); a4_r = a4cR.a4_cb(a4_r); );

// ---------- STEREO: WIDTH (M/S), MONO BASS ----------
a4_m = (a4_l + a4_r) * 0.5; a4_s = (a4_l - a4_r) * 0.5;
