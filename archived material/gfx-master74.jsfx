  while (a4_qt > a4_qh && a4_DQV[(a4_qt - 1) & 1023] >= a4_req) ( a4_qt -= 1; );
  a4_DQV[a4_qt & 1023] = a4_req; a4_DQI[a4_qt & 1023] = a4_n; a4_qt += 1;
  while (a4_DQI[a4_qh & 1023] <= a4_n - a4_LA) ( a4_qh += 1; );
