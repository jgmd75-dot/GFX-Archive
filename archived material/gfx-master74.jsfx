  a4_tmo != a4_mod ? ( a4_mod = a4_tmo; a4_mt = a4_trim(); a4_eqset(); a4_update(); );
  a4_eq = a4_teq; a4_ci = a4_tci; a4_li = a4_tli;
  a4_tmb != a4_mb ? ( a4_mb = a4_tmb; a4_mb > 0 ? a4_mbset(); );
  a4_dynclr(); a4_ostset();
  a4_hold = a4_LAT + 8; a4_fst = 2; ); ) :
a4_fst == 2 ? ( a4_hold -= 1; a4_hold <= 0 ? a4_fst = 3; ) :
a4_fst == 3 ? ( a4_fade += a4_fd; a4_fade >= 1 ? ( a4_fade = 1; a4_fst = 0; ); );

// ---------- input: TRIM, GUARD; OB: the input iron (the lows saturate first) ----------
in_process(spl0, spl1);
a4_l = in_l; a4_r = in_r;
a4_viL = max(a4_viL * 0.9995, abs(a4_l) + abs(a4_r));
!a4_mod ? (
  a4_i1 += (a4_l - a4_i1) * a4_kl1; a4_l += s74_th(a4_i1 * a4_ki) / a4_ki - a4_i1;
  a4_i2 += (a4_r - a4_i2) * a4_kl1; a4_r += s74_th(a4_i2 * a4_ki) / a4_ki - a4_i2;
);

// ---------- EQ ----------
a4_eqg ? (
  a4_lg += (a4_tlg - a4_lg) * a4_sm; a4_mg += (a4_tmg - a4_mg) * a4_sm; a4_hg += (a4_thg - a4_hg) * a4_sm;
  a4_lf += (a4_tlf - a4_lf) * a4_sm; a4_mf += (a4_tmf - a4_mf) * a4_sm; a4_hf += (a4_thf - a4_hf) * a4_sm;
  abs(a4_tlg - a4_lg) + abs(a4_tmg - a4_mg) + abs(a4_thg - a4_hg) + abs(a4_tlf - a4_lf) + abs(a4_tmf - a4_mf) + abs(a4_thf - a4_hf) < 0.0005 ? (
    a4_lg = a4_tlg; a4_mg = a4_tmg; a4_hg = a4_thg; a4_lf = a4_tlf; a4_mf = a4_tmf; a4_hf = a4_thf; a4_eqg = 0; );
  a4_eqset();
);
a4_eq ? (
  // a band at 0 dB is left out (its filter is then identity); it starts from rest when it comes back
  a4_lg != 0 ? ( a4_l = a4sLl.a4_sv(a4_l, a4qL.a1, a4qL.a2, a4qL.a3, a4qL.m0, a4qL.m1, a4qL.m2); a4_r = a4sLr.a4_sv(a4_r, a4qL.a1, a4qL.a2, a4qL.a3, a4qL.m0, a4qL.m1, a4qL.m2); )
             : a4sLl.s1 = a4sLl.s2 = a4sLr.s1 = a4sLr.s2 = 0;
  a4_mg != 0 ? ( a4_l = a4sMl.a4_sv(a4_l, a4qM.a1, a4qM.a2, a4qM.a3, a4qM.m0, a4qM.m1, a4qM.m2); a4_r = a4sMr.a4_sv(a4_r, a4qM.a1, a4qM.a2, a4qM.a3, a4qM.m0, a4qM.m1, a4qM.m2); )
             : a4sMl.s1 = a4sMl.s2 = a4sMr.s1 = a4sMr.s2 = 0;
  a4_hg != 0 ? ( a4_l = a4sHl.a4_sv(a4_l, a4qH.a1, a4qH.a2, a4qH.a3, a4qH.m0, a4qH.m1, a4qH.m2); a4_r = a4sHr.a4_sv(a4_r, a4qH.a1, a4qH.a2, a4qH.a3, a4qH.m0, a4qH.m1, a4qH.m2); )
             : a4sHl.s1 = a4sHl.s2 = a4sHr.s1 = a4sHr.s2 = 0;
