  a4_g1 += (a4_gr - a4_g1) * (a4_gr > a4_g1 ? a4_ka : a4_kr);
  a4_aut ? ( a4_g2 += (a4_gr - a4_g2) * (a4_gr > a4_g2 ? a4_ka2 : a4_kr2); a4_gt = max(a4_g1, a4_g2); ) : a4_gt = a4_g1;
  a4_cgm = max(a4_cgm, a4_gt);
