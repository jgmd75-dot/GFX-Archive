// ---------- LIMITER ----------
a4_dre = a4_li ? a4_dr : 1;
a4_l *= a4_dre; a4_r *= a4_dre;
a4_w = (a4_w + 1) & 1023; a4_n += 1;
a4_XL[a4_w] = a4_XL[a4_w + 1024] = a4_l; a4_XR[a4_w] = a4_XR[a4_w + 1024] = a4_r;
a4_rd = a4_w + 1024 - a4_LAT;
!a4_li ? (
  a4_yl = a4_XL[a4_rd]; a4_yr = a4_XR[a4_rd];
) : a4_mod ? (
  // CLEAN: the true peak (4x) around the sample 12 back, the gain it needs, held for the lookahead and averaged over it
  a4_pl = a4_XL + a4_w + 1024; a4_pr = a4_XR + a4_w + 1024;
  a4_1l = a4_2l = a4_3l = a4_1r = a4_2r = a4_3r = 0; j_ = 0;
  loop(25, a4_xa = a4_pl[-j_]; a4_xb = a4_pr[-j_]; a4_c1 = a4_FP[j_]; a4_c2 = a4_FP[25 + j_]; a4_c3 = a4_FP[50 + j_];
    a4_1l += a4_c1 * a4_xa; a4_2l += a4_c2 * a4_xa; a4_3l += a4_c3 * a4_xa;
    a4_1r += a4_c1 * a4_xb; a4_2r += a4_c2 * a4_xb; a4_3r += a4_c3 * a4_xb; j_ += 1; );
  // the 4x points in time order: (u3 before), x[n-12], u1, u2, u3, (x[n-11])
  a4_0l = a4_pl[-12]; a4_0r = a4_pr[-12];
  a4_ip = max(max(a4_par(a4_zl, a4_0l, a4_1l), a4_par(a4_0l, a4_1l, a4_2l)), max(a4_par(a4_1l, a4_2l, a4_3l), a4_par(a4_2l, a4_3l, a4_pl[-11])));
  a4_ip = max(a4_ip, max(max(a4_par(a4_zr, a4_0r, a4_1r), a4_par(a4_0r, a4_1r, a4_2r)), max(a4_par(a4_1r, a4_2r, a4_3r), a4_par(a4_2r, a4_3r, a4_pr[-11]))));
  a4_zl = a4_3l; a4_zr = a4_3r;
