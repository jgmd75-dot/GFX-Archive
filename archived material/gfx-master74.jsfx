a4_ci ? (
  a4_sl_ = a4_scf > 0 ? a4sL.s74_bq(a4_l) : a4_l; a4_sr_ = a4_scf > 0 ? a4sR.s74_bq(a4_r) : a4_r;
  a4_mod ? (
    a4_ms += ((a4_sl_ * a4_sl_ + a4_sr_ * a4_sr_) * 0.5 - a4_ms) * a4_krms;
    a4_lv = 10 * log10(max(a4_ms, 0.000000000001)) + 3;               // RMS, read like a peak for a sine
    a4_gr = a4_gc(a4_lv - a4_th - a4_dth, a4_sl * 0.5, a4_kn);        // the leveller: half the slope, a wide knee
  ) : (
