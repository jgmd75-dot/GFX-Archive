desc:GFX Meter57 [level meter]
//tags: meter vu ppm peak correlation phase scope lissajous magic eye broadcast mastering analyser series57
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-ui, gfx-panel and gfx-s57 (.jsfx-inc) in the same folder.
//
// METER57 (Series 57). The 1957 counterpart of Meter81: the measuring corner of a late-50s control room - two big
// moving-coil meters in amber windows, a small cathode-ray tube for the stereo picture (the 45/45 stereo disc was new
// in 1957) and a magic-eye tube for the correlation, the peaks held on nixie tubes.
// The audio is NOT touched: the plug-in only reads spl0 / spl1 and never writes them (bit-exact, latency 0).
//   SCALE  VU, PPM or PEAK.
//     VU    the volume indicator: the rectified average drives a modelled needle (a second-order system, 300 ms to
//           99 %, about 1.5 % overshoot). -20 .. +3 VU; 0 VU = REF.
//     PPM   the quasi-peak programme meter: a 5 ms integration (a 10 ms burst reads 1 dB under), a slow, steady return.
//           The face picks the standard: ULM the German DIN scale (-50 .. +5 dB, return 20 dB in 1.5 s), COPENHAGEN
//           the Nordic scale (-36 .. +9 dB, return 20 dB in 1.7 s). 0 dB = REF.
//     PEAK  the sample peak: instant attack, a return of 20 dB in 1.7 s. -60 .. 0 dBFS (REF does not apply).
//   REF  the alignment level: 0 VU / 0 dB = -18, -14, -12 or -9 dBFS (sine-referenced: a sine whose peak is at REF
//        reads 0).
//   HOLD  OFF / 2 S / INF: an orange drag pointer on each meter. The nixie tubes show the true sample peak of each
//        channel since the last reset (click them to reset; with HOLD OFF they hold each peak for 2 s). OVER lights at
//        0 dBFS.
//   The SCOPE draws the stereo picture (mid up, side across): a vertical line is mono, a circle is wide, a horizontal
//   line is out of phase. The MAGIC EYE closes as the channels agree: fully closed = +1 (mono), half open = 0
//   (unrelated), wide open with the shadow red = negative (out of phase); the number underneath is the correlation.
// ULM / COPENHAGEN (the face): the look, and the PPM standard (see above).
// No DRIFT: a meter must not wander.

import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-s57.jsfx-inc

slider1:0<0,2,1{VU,PPM,Peak}>-Scale
slider2:0<0,3,1{-18 dBFS,-14 dBFS,-12 dBFS,-9 dBFS}>-Ref level
slider3:1<0,2,1{Off,2 s,Inf}>-Hold
slider4:0<0,1,1{Ulm,Copenhagen}>-Face

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-meter57";
ext_noinit = 1;
s57_mem = 0;
mt_SC = s57_alloc(2048);                                // the scope's points: mid, side
mt_sp = 0;
function mt_init() (
  mt_sr = srate;
  mt_w = 13.6; mt_z = 0.81;                             // the VU needle: natural frequency (rad/s), damping
  mt_ka = s57_kt(0.0015, srate);                        // the PPM's integration (5 ms: a 10 ms burst reads -1 dB)
  mt_kc = s57_kt(0.3, srate);                           // the correlation's averaging
);
mt_init();
mt_vuL = mt_vuR = mt_vvL = mt_vvR = 0; mt_ppL = mt_ppR = 0; mt_pkL = mt_pkR = 0;
mt_hL = mt_hR = 0; mt_cLR = mt_cLL = mt_cRR = 0.000001;

function mt_set(s, r, h) ( slider1 = s; slider2 = r; slider3 = h; slider_automate(7); );
#mt_pm = "Init|Broadcast PPM|PPM Align -18|Live Desk -12|Tracking VU|Mix VU -14|Hot Master VU|Mastering Peak|Peak Hold|Film VU -18|Stereo Check|Programme PPM -9";
function load_preset(p) (
  p == 1  ? mt_set(0, 0, 1) :
  p == 2  ? mt_set(1, 3, 1) :
  p == 3  ? mt_set(1, 0, 1) :
  p == 4  ? mt_set(1, 2, 1) :
  p == 5  ? mt_set(0, 0, 0) :
  p == 6  ? mt_set(0, 1, 1) :
  p == 7  ? mt_set(0, 2, 1) :
  p == 8  ? mt_set(2, 0, 1) :
  p == 9  ? mt_set(2, 0, 2) :
  p == 10 ? mt_set(0, 0, 2) :
  p == 11 ? mt_set(0, 0, 0) :
  p == 12 ? mt_set(1, 3, 2) :
  p == 13 ? mt_set(0, 0, 1);
  pr_cur = p;
);

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@block
srate != mt_sr ? mt_init();
mt_fc = slider4 >= 0.5;
// the PPM's return: linear in dB (DIN 20 dB in 1.5 s, Nordic 20 dB in 1.7 s); the PEAK's: 20 dB in 1.7 s
mt_kp = 10 ^ (-20 / 20 / ((mt_fc ? 1.7 : 1.5) * srate));
mt_kk = 10 ^ (-20 / 20 / (1.7 * srate));
mt_ref = slider2 == 0 ? -18 : slider2 == 1 ? -14 : slider2 == 2 ? -12 : -9;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
mt_l = spl0; mt_r = spl1;
// VU: the rectified signal drives the needle (a mass on a spring, damped). A sine reads its average (2 / pi of the
// peak); the scale is calibrated so a sine at REF peak reads 0 VU.
mt_vvL += (mt_w * mt_w * (abs(mt_l) * 1.5708 - mt_vuL) - 2 * mt_z * mt_w * mt_vvL) / srate; mt_vuL += mt_vvL / srate;
mt_vvR += (mt_w * mt_w * (abs(mt_r) * 1.5708 - mt_vuR) - 2 * mt_z * mt_w * mt_vvR) / srate; mt_vuR += mt_vvR / srate;
// PPM: quick integration up, a steady return
mt_a = abs(mt_l); mt_ppL = mt_a > mt_ppL ? mt_ppL + (mt_a - mt_ppL) * mt_ka : mt_ppL * mt_kp;
mt_a = abs(mt_r); mt_ppR = mt_a > mt_ppR ? mt_ppR + (mt_a - mt_ppR) * mt_ka : mt_ppR * mt_kp;
// PEAK
mt_pkL = max(abs(mt_l), mt_pkL * mt_kk); mt_pkR = max(abs(mt_r), mt_pkR * mt_kk);
// the true sample peaks for the nixies
mt_hL = max(mt_hL, abs(mt_l)); mt_hR = max(mt_hR, abs(mt_r));
// correlation
mt_cLR += (mt_l * mt_r - mt_cLR) * mt_kc; mt_cLL += (mt_l * mt_l - mt_cLL) * mt_kc; mt_cRR += (mt_r * mt_r - mt_cRR) * mt_kc;
// the scope: mid and side, every 4th sample
(mt_dec += 1) >= 4 ? ( mt_dec = 0; mt_SC[mt_sp * 2] = (mt_l + mt_r) * 0.7071; mt_SC[mt_sp * 2 + 1] = (mt_r - mt_l) * 0.7071; mt_sp = (mt_sp + 1) & 1023; );

@gfx 960 400
ui_begin(960, 400);
s57_pal(slider4);
s57_fonts();
s57_face(960, 400);
k_ = s57_header(960, "METER57", "SERIES 57", "LEVEL METER", #mt_pm, 4);
k_ > 0 ? load_preset(k_);

// the readings, in the scale's units
md_ = slider1 == 0 ? 0 : slider1 == 1 ? (slider4 >= 0.5 ? 2 : 1) : 3;
mt_rf = mt_ref;
md_ == 0 ? ( rL_ = 20 * log10(max(mt_vuL, 0.0000001)) - mt_rf; rR_ = 20 * log10(max(mt_vuR, 0.0000001)) - mt_rf; ) :
md_ <= 2 ? ( rL_ = 20 * log10(max(mt_ppL, 0.0000001)) - mt_rf; rR_ = 20 * log10(max(mt_ppR, 0.0000001)) - mt_rf; ) :
           ( rL_ = 20 * log10(max(mt_pkL, 0.0000001)); rR_ = 20 * log10(max(mt_pkR, 0.0000001)); );
// HOLD: the drag pointers
t_ = time_precise();
slider3 == 0 ? ( mt_dL = mt_dR = -999; ) : (
  (rL_ > mt_dL || (slider3 == 1 && t_ - mt_tL > 2)) ? ( mt_dL = rL_; mt_tL = t_; );
  (rR_ > mt_dR || (slider3 == 1 && t_ - mt_tR > 2)) ? ( mt_dR = rR_; mt_tR = t_; );
  slider3 == 1 && t_ - mt_tL > 2 ? mt_dL = rL_; slider3 == 1 && t_ - mt_tR > 2 ? mt_dR = rR_;
);
mt_dL < -200 && slider3 > 0 ? mt_dL = rL_; mt_dR < -200 && slider3 > 0 ? mt_dR = rR_;
// the nixies: the held true peaks
mt_nL = max(mt_nL, mt_hL); mt_nR = max(mt_nR, mt_hR); mt_hL = mt_hR = 0;
slider3 == 0 && t_ - mt_nt > 2 ? ( mt_nL = mt_nR = 0; mt_nt = t_; );
mt_ov = mt_nL >= 1 || mt_nR >= 1;

lb_ = md_ == 0 ? "VU" : md_ == 1 ? "PPM  DIN" : md_ == 2 ? "PPM  NORDIC" : "dBFS";
s57_plate(20, 68, 624, 292);
mtA.s57_arcm(34, 80, 296, 186, rL_, slider3 > 0 ? mt_dL : -999, md_, lb_, "LEFT");
mtB.s57_arcm(334, 80, 296, 186, rR_, slider3 > 0 ? mt_dR : -999, md_, lb_, "RIGHT");
// the keys and the nixies
gfx_setfont(13); ui_col(S57_INK);
s57_t(34, 278, "SCALE"); s57_t(196, 278, "REF  (dBFS)"); s57_t(424, 278, "HOLD");
m_ = 0; loop(3, s57_key(34 + m_ * 52, 292, 48, 22, slider1 == m_, m_ == 0 ? "VU" : m_ == 1 ? "PPM" : "PEAK") ? s57_set(1, m_); m_ += 1; );
m_ = 0; loop(4, s57_key(196 + m_ * 54, 292, 50, 22, slider2 == m_, m_ == 0 ? "-18" : m_ == 1 ? "-14" : m_ == 2 ? "-12" : "-9") ? s57_set(2, m_); m_ += 1; );
m_ = 0; loop(3, s57_key(424 + m_ * 70, 292, 64, 22, slider3 == m_, m_ == 0 ? "OFF" : m_ == 1 ? "2 S" : "INF") ? s57_set(3, m_); m_ += 1; );
slider1 == 2 ? ( ui_cola(S57_PLATE, 0.6); s57_r(194, 290, 220, 26); );
// the peak nixies (click to reset)
s57_small(34, 330, "PEAK  L");
sprintf(#nl_, "%+5.1f", 20 * log10(max(mt_nL, 0.0000001))); mt_nL < 0.00001 ? strcpy(#nl_, " ---");
s57_nixie(96, 324, 120, 28, #nl_, mt_nL >= 0.00001);
s57_small(236, 330, "R");
sprintf(#nr_, "%+5.1f", 20 * log10(max(mt_nR, 0.0000001))); mt_nR < 0.00001 ? strcpy(#nr_, " ---");
s57_nixie(252, 324, 120, 28, #nr_, mt_nR >= 0.00001);
s57_hov(96, 324, 276, 28) && pressed && drag_id == 0 ? ( drag_id = -1; mt_nL = mt_nR = 0; mt_dL = mt_dR = -999; );
s57_small(384, 330, "OVER"); pk_led(436 * sc, 336 * sc, 5 * sc, mt_ov, 0xFF3A22);
s57_small(458, 330, "CLICK THE TUBES TO RESET");

// ---------- the stereo picture ----------
s57_well(660, 68, 280, 292);
s57_title(672, 76, "STEREO");
cx_ = 744; cy_ = 168; r_ = 62;
ui_col(S57_INK); gfx_circle(cx_ * sc, cy_ * sc, (r_ + 8) * sc, 1, 1);
ui_col(0x0B140F); gfx_circle(cx_ * sc, cy_ * sc, r_ * sc, 1, 1);
ph_ = slider4 >= 0.5 ? 0xFFB347 : 0x7CFFB0;                // the phosphor: green (ULM) or amber (COPENHAGEN)
ui_cola(ph_, 0.15); s57_r(cx_ - r_ + 6, cy_, 2 * r_ - 12, 1); s57_r(cx_, cy_ - r_ + 6, 1, 2 * r_ - 12);
// the trace: auto-scaled gently so quiet material still shows a shape
mx_ = 0.000001; i_ = 0; loop(256, mx_ = max(mx_, abs(mt_SC[((mt_sp - i_) & 1023) * 2]) + abs(mt_SC[((mt_sp - i_) & 1023) * 2 + 1])); i_ += 1; );
mt_sg = max(mt_sg * 0.9, mx_); g_ = (r_ - 6) / max(mt_sg, 0.05);
i_ = 0; loop(255,
  j_ = (mt_sp - 1 - i_) & 1023; k2_ = (j_ - 1) & 1023;
  ui_cola(ph_, 0.65 * (1 - i_ / 256));
  x1_ = cx_ + mt_SC[j_ * 2 + 1] * g_; y1_ = cy_ - mt_SC[j_ * 2] * g_;
  x2_ = cx_ + mt_SC[k2_ * 2 + 1] * g_; y2_ = cy_ - mt_SC[k2_ * 2] * g_;
  gfx_line(x1_ * sc, y1_ * sc, x2_ * sc, y2_ * sc, 1);
  i_ += 1; );
ui_cola(0xFFFFFF, 0.06); gfx_circle((cx_ - 18) * sc, (cy_ - 22) * sc, 26 * sc, 1, 1);
gfx_setfont(13); ui_col(S57_DIM); s57_tc(cx_, cy_ + r_ + 18, "M  /  S");
// the magic eye: the correlation
co_ = mt_cLR / sqrt(max(mt_cLL * mt_cRR, 0.000000000001)); co_ = min(max(co_, -1), 1);
(mt_cLL + mt_cRR) < 0.0000001 ? co_ = 1;
mt_co += (co_ - mt_co) * 0.25;
ex_ = 878; ey_ = 168; er_ = 40;
ui_col(S57_INK); gfx_circle(ex_ * sc, ey_ * sc, (er_ + 6) * sc, 1, 1);
ui_col(0x0E1A10); gfx_circle(ex_ * sc, ey_ * sc, er_ * sc, 1, 1);
// the glowing fan (the shadow's angle opens as the correlation falls)
sh_ = (1 - mt_co) * 0.5 * $pi * 0.95 + 0.05;             // half-angle of the shadow, from the top
i_ = 0; loop(64,
  a_ = i_ / 64 * 2 * $pi;
  d_ = abs(a_ - $pi) ; d_ = $pi - d_;                    // distance from the top (0 .. pi)
  d_ > sh_ ? ( ui_cola(0x5CFF7A, 0.55 + 0.35 * cos(a_ * 3) * 0.2);
               s57_ln(ex_ + sin(a_) * 10, ey_ - cos(a_) * 10, ex_ + sin(a_) * (er_ - 3), ey_ - cos(a_) * (er_ - 3), 3.2); ) :
             ( mt_co < 0 ? ( ui_cola(0xFF3A22, 0.25); s57_ln(ex_ + sin(a_) * 10, ey_ - cos(a_) * 10, ex_ + sin(a_) * (er_ - 3), ey_ - cos(a_) * (er_ - 3), 3.2); ); );
  i_ += 1; );
ui_col(0x22301F); gfx_circle(ex_ * sc, ey_ * sc, 9 * sc, 1, 1);
gfx_setfont(13); ui_col(S57_INK); s57_tc(ex_, ey_ + er_ + 18, "CORRELATION");
sprintf(#co_, "%+.2f", mt_co); s57_nixie(ex_ - 40, ey_ + er_ + 30, 80, 26, #co_, 1);
s57_small(672, 316, "VERTICAL = MONO, A CIRCLE = WIDE,");
s57_small(672, 330, "HORIZONTAL = OUT OF PHASE");

s57_cheeks(960, 400);
pk_end();
ui_end();
