desc:GFX STR74 [vocal strip]
//tags: vocal channel strip preamp opto fet de-esser eq saturation phaser tape echo ducking broadcast series74
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-clip, gfx-ui, gfx-panel, gfx-dyn and gfx-s74 (.jsfx-inc) in the same folder.
//
// STR74 (Series 74: the OB remote and broadcast series): the series' vocal strip - the STR92 core chain voiced as the
// desk of an outside-broadcast truck, with the series' own phaser and tape echo. Two models on one switch, as every
// Series 74 unit: the MODEL keys (OB / CLEAN, in the header) set the voicing of every stage and the faceplate
// together; a change ducks the output (12 ms), swaps at the silent point and fades back in. At Init the two models are
// level matched.
//   OB     the truck: transformer coupled and ballsy. The INPUT IRON saturates the lows first, then a single-ended
//          class-A stage (one side of the wave gives before the other); an EQ coupled by transformers (proportional
//          Q, a little bump on the low shelf, a soft top, neighbouring bands loading each other); an opto that leans
//          in; the FET's colour; iron + class-A saturation; the phaser's 90 voicing (a little grit); a worn field
//          tape echo (more wow and flutter, a darker, hotter loop).
//   CLEAN  the light-grey broadcast desk: an active balanced line driver with lots of headroom (linear until it is
//          pushed hard, then a symmetrical round-off); an exact EQ (the curves as set); a lighter opto; a cleaner
//          FET; IC rail saturation (symmetrical, no tilt); the phaser's OPTO voicing (smooth); a well-aligned studio
//          tape echo (a trace of wow, a cleaner loop).
// The chain, in order:
//   PREAMP     DRIVE (level matched: more DRIVE, more colour; house drive standard: anti-aliased clipper,
//              drive-tracking pre-filter and knee). TRIM and GUARD (the house input stage) sit here too.
//   LOW END    the house trick: a high-pass (20 - 80 Hz, 20 = off), then a low shelf at 150 Hz pulling 0 to -3 dB.
//   EQ         a four-band parametric: LF (shelf or bell, 30 - 450 Hz, +/-15 dB), LMF (bell, 120 Hz - 2 kHz, gain,
//              Q), HMF (bell, 600 Hz - 8 kHz, gain, Q), HF (shelf or bell, 1.5 - 16 kHz). A SHELF / BELL change glides
//              the band out and back in. The ORDER key puts the EQ before or after the dynamics (OPTO, DE-ESS, FET);
//              the panel modules swap places.
//   OPTO       slow optical levelling (always before the FET): PEAK REDUCTION and GAIN; program dependent, with a
//              smooth two-stage release. OB leans on it more.
//   DE-ESS     split band: only the sibilant band is turned down, by no more than RANGE: the cut starts at FREQ
//              (4 - 10 kHz; an 8th-order split at 1.2 x FREQ, so the presence below about 0.8 x FREQ is left alone;
//              the split's all-pass stays in the path when DE-ESS is out, so switching it never combs)
//              and is full an octave above. It listens for sibilance, not brightness: THRESH sets how loud the band
//              must be, and it only cuts while the band stands out from the rest of the signal (within 6 dB of the
//              whole: full cut from 2 dB), so steady bright material - a full mix, cymbals, reverb - is left alone
//              while "s" sounds get the full RANGE. Stereo linked. LISTEN plays the band; the lamp lights while it
//              works.
//   FET        a fast peak catcher (always last of the dynamics): AMOUNT (into a fixed threshold), RATIO 4 / 8 / 12 /
//              20, ATTACK, RELEASE; the FET's colour (mostly 2nd harmonic) grows with the gain it takes away (OB more,
//              CLEAN less).
//   SATURATION OB: iron + class A (the lows thicken, the top softens, one side gives first). CLEAN: the IC rails
//              (symmetrical, flat). 0 = out.
//   PHASER     (its own IN key; the GFX Phaser's engine, 4 stages) RATE, CENTRE, DEPTH, FEEDBACK (+/-), MIX, STEREO.
//              OB runs its 90 voicing (a triangle sweep, the grit on the phased path), CLEAN its OPTO voicing (a sine
//              sweep through the photocell's lag, wider range, smooth).
//   TAPE ECHO  (its own IN key; the Echo engine of GFX Echofish, its TAPE type) TIME 60 - 1000 ms or synced (1/16 -
//              1/4 D), TONE (the loop's high cut), FEEDBACK, MIX (100 % = the echo as loud as the voice) and DUCK: the
//              echo pulls back while the voice sings (up to 15 dB) and blooms in the gaps. Turning TIME glides the
//              tape (the repeats bend in pitch). Phaser and echo can run together in either model. The echo is the
//              strip's space (no reverb is added).
//   OUTPUT     OUTPUT level (the desk fader), then the house output stage with CLIP always on (a character unit).
// WANDER (the Series 74 drift; 0 - 100 %, 50 % = standard, 0 = none): OB - the pre-amp's and the saturation's heat
//   wander (an uneven supply, the two sides never quite match), the phaser's rate, width and centre wander, the tape's
//   wow and flutter. CLEAN (a crystal clock, regulated rails) - only a trace of all of it.
// Mono or stereo tracks; the dynamics are stereo linked. Every IN key, the model, the order and the presets change
// without clicks. No latency (0 samples).
// PRESETS (12 + Reset all to defaults) cover both models; TRIM, GUARD and WANDER stay when a preset loads.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-clip.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-s74.jsfx-inc

slider1:0<0,1,1{OB,Clean}>-Model
slider2:0<0,1,1{EQ after dynamics,EQ before dynamics}>-Order
slider3:0<-24,12,0.1>-Input trim (dB)
slider4:1<0,1,1{Off,On}>-Input guard
slider5:1<0,1,1{Out,In}>-Preamp in
slider6:30<0,100,1>-Drive (%)
slider7:60<20,80,1>-High-pass (Hz, 20 = off)
slider8:-2<-3,0,0.1>-Low shelf 150 Hz (dB)
slider9:300<120,2000,1>-EQ LMF freq (Hz)
slider10:-2<-15,15,0.1>-EQ LMF gain (dB)
slider11:0.8<0.4,4,0.01>-EQ LMF Q
slider12:1<0,1,1{Out,In}>-Opto in
slider13:35<0,100,1>-Opto peak reduction (%)
slider14:0<-10,10,0.1>-Opto gain (dB)
slider15:1<0,1,1{Out,In}>-De-ess in
slider16:4500<4000,10000,10>-De-ess freq (Hz)
slider17:-28<-50,0,0.1>-De-ess threshold (dB)
slider18:6<0,12,0.1>-De-ess range (dB)
slider19:0<0,1,1{Off,On}>-De-ess listen
slider20:1<0,1,1{Out,In}>-FET in
slider21:6<0,24,0.1>-FET amount (dB)
slider22:0<0,3,1{4,8,12,20}>-FET ratio
slider23:250<20,800,1>-FET attack (us)
slider24:120<50,1100,1>-FET release (ms)
slider25:1<0,1,1{Out,In}>-EQ in
slider26:0<-15,15,0.1>-EQ LF gain (dB)
slider27:100<30,450,1>-EQ LF freq (Hz)
slider28:0<0,1,1{Shelf,Bell}>-EQ LF shape
slider29:25<0,100,1>-Saturation (%)
slider30:0<0,1,1{Out,In}>-Phaser in
slider31:0.25<0.02,5,0.01>-Phaser rate (Hz)
slider32:60<0,100,1>-Phaser depth (%)
slider33:20<-90,90,1>-Phaser feedback (%)
slider34:40<0,100,1>-Phaser mix (%)
slider35:1<0,1,1{Off,On}>-Phaser stereo
slider36:1<0,1,1{Out,In}>-Echo in
slider37:320<60,1000,1>-Echo time (ms)
slider38:0<0,7,1{Free,1/16,1/8 T,1/8,1/8 D,1/4 T,1/4,1/4 D}>-Echo sync
slider39:40<0,100,1>-Echo tone (%)
slider40:25<0,100,1>-Echo feedback (%)
slider41:18<0,100,1>-Echo mix (%)
slider42:50<0,100,1>-Echo duck (%)
slider43:50<0,100,1>-Phaser centre (%)
slider49:50<0,100,1>-Wander (%)
slider50:0<-12,12,0.1>-Output (dB)
slider51:2<-15,15,0.1>-EQ HMF gain (dB)
slider52:3000<600,8000,1>-EQ HMF freq (Hz)
slider53:0.8<0.4,4,0.01>-EQ HMF Q
slider54:-1.5<-15,15,0.1>-EQ HF gain (dB)
slider55:10000<1500,16000,10>-EQ HF freq (Hz)
slider56:0<0,1,1{Shelf,Bell}>-EQ HF shape

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-str74";
ext_noinit = 1;
clp_aa = 1; clp_pf_on = 1; clp_kt_on = 1;                   // house drive standard: ADAA, pre-filter, knee tracking (character)

// ================= memory =================
function vx_alloc(n) local(p) ( p = vx_mem; vx_mem += n; memset(p, 0, n); p; );
function vx_p2(n) local(m) ( m = 16; while (m < n) ( m *= 2; ); m; );
function vx_db(d) ( exp(0.11512925465 * d); );
function vx_kt(t) ( 1 - exp(-1 / (max(t, 0.000001) * srate)); );           // a time constant (s) as a one-pole coefficient
function vx_kf(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * srate) / srate); );   // a one-pole low-pass coefficient for f Hz

// a per-block glide that snaps when close (instance: v)
function gl(t) instance(v) ( v += (t - v) * vx_gb; abs(t - v) < 0.0001 * max(abs(t), 0.01) ? v = t; v; );
function gl_set(t) instance(v) ( v = t; );

// ================= PREAMP: the input iron (lows first) + the gain stage (a biased gfx-clip KNEE clipper) =================
// one side: x in, kk = the drive into the stage; the curve's rest value and slope are taken out (unity small-signal
// gain); the anti-aliased reading's half-sample lag is made up, so it mixes with the dry signal without a comb
function pre_run(x, kk) instance(lo, c1) local(u, y, c) (
  lo += (x - lo) * pre_lc;
  x += pre_xa * (lo / sqrt(1 + sqr(pre_xd * lo)) - lo);    // the iron: the lows saturate first
  u = this.pf.clp_pf_run(x) * kk + pre_b;
  y = this.k.clp_run(u); c = this.k.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  (y - pre_cb) / (kk * pre_sl);
);
// SATURATION, one side: OB iron + class A (a biased, lopsided KNEE clipper), CLEAN the IC rails (a SOFT clipper)
function sat_run(x, kk) instance(c1) local(u, y, c) (
  u = this.pf.clp_pf_run(x) * kk + sat_b;
  y = this.k.clp_run(u); c = this.k.clp_crv(u);
  y += 0.5 * (c - c1); c1 = c;
  (y - sat_cb) / (kk * sat_sl);
);

// ================= DE-ESS: an 8th-order Linkwitz-Riley split (instance: one side) =================
// the band above the split (two cascaded 4th-order Butterworth high-passes) and the split's own 4th-order all-pass
// (its low + high sum): out = all-pass(x) + g x band, so the response is exactly 1 + g w^8 / (1 + w^8) - flat below
// the split, the full cut above it, the same phase on both sides, no comb anywhere
function dsx_ap(f, q) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * q); n = 1 + al;
  b0 = (1 - al) / n; b1 = -2 * cw / n; b2 = 1; a1 = b1; a2 = b0;
);
function dsx_set(fc) (
  this.h1.bq_set(1, fc, 0.5411961, 0); this.h2.bq_set(1, fc, 1.3065630, 0);
  this.h3.bq_set(1, fc, 0.5411961, 0); this.h4.bq_set(1, fc, 1.3065630, 0);
  this.p1.dsx_ap(fc, 0.5411961); this.p2.dsx_ap(fc, 1.3065630);
);
// one sample: returns the all-passed signal; the band is left in .hi
function dsx_run(x) instance(hi) (
  hi = this.h4.bq_run(this.h3.bq_run(this.h2.bq_run(this.h1.bq_run(x))));
  this.p2.bq_run(this.p1.bq_run(x));
);
// the all-pass alone (DE-ESS out: the path keeps the same phase, so switching never combs)
function dsx_apr(x) ( this.p2.bq_run(this.p1.bq_run(x)); );

// =====================================================================================================================
// SERIES 74 MOD + SPACE (prefix t7): the parts that make this strip the Series 74 one. The core chain above (vx_) is
// shared by the vocal-strip family (ported from STR92); each series brings its own mod / space here.
// =====================================================================================================================
function t7_tanh(x) local(e) ( x = min(max(x, -20), 20); e = exp(2 * x); (e - 1) / (e + 1); );

// ---------- PHASER: ported from gfx-phaser.jsfx (GFX Phaser) ----------
// Its first-order all-pass chain (4 stages, its STAGES default), its feedback through the soft limiter, its mix law
// (the wet scaled by sqrt(1 - fb^2)), its voicings and its drift (rate 5 %, depth 10 %, centre 10 %, 0.25 Hz). OB runs
// its 90 voicing (120 Hz - 2.4 kHz, 2.5 octaves, the u^1.5 sweep law, a triangle LFO and the 90's soft limiter, here on
// the phased path only, so the voice itself is never clipped); CLEAN its OPTO voicing (80 Hz - 2 kHz, 3.5 octaves,
// the photocell's lag: 8 ms up, 120 ms down, the u^0.8 law, a sine LFO). RATE = its free rate, CENTRE, DEPTH,
// FEEDBACK, MIX; STEREO = SPREAD 90 deg (off: 0). The sweep's coefficients are worked out every 4 samples and ramped
// in between (the strip's: the same sweep for a quarter of the tangents).
function t7p_sat(x) local(a) ( a = abs(x); a < 0.7 ? x : sign(x) * (0.7 + 0.3 * t7_tanh((a - 0.7) / 0.3)); );
function t7p_shp(p) ( t7p_mode ? sin(2 * $pi * p) : p < 0.25 ? 4 * p : p < 0.75 ? 2 - 4 * p : 4 * p - 4; );
function t7p_set() (
  t7p_on = slider30 >= 0.5;
  t7p_mode = eng;                                          // OB its 90 voicing, CLEAN its OPTO voicing
  t7p_rate = min(max(slider31, 0.02), 5);
  t7p_dep_t = slider32 / 100; t7p_cen_t = slider43 / 100;
  t7p_fb_t = min(max(slider33 / 100, -0.9), 0.9); t7p_mix_t = slider34 / 100;
  t7p_spr = slider35 >= 0.5 ? 0.25 : 0;
  t7p_rd = 0.05 * dm_a * vx_wf; t7p_dd = min(0.10 * dm_a * vx_wf, 1); t7p_cd = 0.10 * dm_a * vx_wf; t7p_dspd = 0.25 * dm_s;
  !t7p_mode ? ( t7p_fmin = 120; t7p_fmax = 2400; t7p_oct = 2.5; ) : ( t7p_fmin = 80; t7p_fmax = 2000; t7p_oct = 3.5; );
);
function t7p_clear() (
  t7p_l1 = t7p_l2 = t7p_l3 = t7p_l4 = t7p_m1 = t7p_m2 = t7p_m3 = t7p_m4 = 0;
  t7p_r1 = t7p_r2 = t7p_r3 = t7p_r4 = t7p_s1 = t7p_s2 = t7p_s3 = t7p_s4 = 0;
  t7p_fl = t7p_fr = 0; t7p_oL = t7p_oR = 0.5; t7p_cc = 0;
);
function t7p_init() (
  t7p_af = 1 - exp(-4 / (0.008 * srate)); t7p_as = 1 - exp(-4 / (0.12 * srate));   // its opto lag (per 4 samples)
  t7p_k4 = 1 - exp(-4 / (0.03 * srate));                   // its 30 ms knob glide (per 4 samples)
  t7p_ks = 1 - exp(-4 / (0.3 * srate));
  t7p_set(); t7p_sp = t7p_spr; t7p_dep = t7p_dep_t; t7p_cen = t7p_cen_t; t7p_fb = t7p_fb_t; t7p_mix = t7p_mix_t;
  t7p_clear();
);
// the control step (every 4 samples): its LFO, its drift, its sweep law, the all-pass coefficients (ramped)
function t7p_ctl(snap) local(vr, vd, vc, dp, coct, uL, uR, p, fcc, f, t, a) (
  vr = t7p_dR.drift_tick(4 * t7p_dspd / srate); vd = t7p_dD.drift_tick(4 * t7p_dspd / srate); vc = t7p_dC.drift_tick(4 * t7p_dspd / srate);
  t7p_dep += (t7p_dep_t - t7p_dep) * t7p_k4; t7p_cen += (t7p_cen_t - t7p_cen) * t7p_k4;
  t7p_ph += 4 * t7p_rate * (1 + t7p_rd * vr) / srate; t7p_ph -= floor(t7p_ph);
  t7p_sp += (t7p_spr - t7p_sp) * t7p_ks;                   // (the strip's) STEREO glides the right side's phase (0.3 s)
  uL = t7p_shp(t7p_ph); p = t7p_ph + t7p_sp; p -= floor(p); uR = t7p_shp(p);
  dp = t7p_dep * (1 - t7p_dd * (0.5 + 0.5 * vd)); coct = t7p_cd * vc * 1.5;
  uL = 0.5 + 0.5 * uL; uR = 0.5 + 0.5 * uR;
  t7p_mode ? (
    t7p_oL += (uL - t7p_oL) * (uL > t7p_oL ? t7p_af : t7p_as); t7p_oR += (uR - t7p_oR) * (uR > t7p_oR ? t7p_af : t7p_as);
    uL = max(t7p_oL, 0) ^ 0.8; uR = max(t7p_oR, 0) ^ 0.8;
  ) : ( uL = max(uL, 0) ^ 1.5; uR = max(uR, 0) ^ 1.5; );
  fcc = t7p_fmin * (t7p_fmax / t7p_fmin) ^ t7p_cen;
  f = min(max(fcc * 2 ^ (dp * t7p_oct * (2 * uL - 1) + coct), 20), srate * 0.45); t7p_fc = f;
  t = tan($pi * f / srate); a = (t - 1) / (t + 1);
  snap ? ( t7p_aL = a; t7p_daL = 0; ) : t7p_daL = (a - t7p_aL) * 0.25;
  f = min(max(fcc * 2 ^ (dp * t7p_oct * (2 * uR - 1) + coct), 20), srate * 0.45);
  t = tan($pi * f / srate); a = (t - 1) / (t + 1);
  snap ? ( t7p_aR = a; t7p_daR = 0; ) : t7p_daR = (a - t7p_aR) * 0.25;
);
function t7p_run() local(st, a, x, y, yl, yr, fbc, m) (
  st = t7p_w <= 0.000001;                                  // (the strip's) starting from rest: no sweep-in
  t7p_w += (t7p_on - t7p_w) * xs_c;
  t7p_w > 0.000001 || t7p_on ? (
    st ? t7p_clear();
    (t7p_cc -= 1) <= 0 ? ( t7p_cc = 4; t7p_ctl(st); );
    t7p_aL += t7p_daL; t7p_aR += t7p_daR;
    t7p_fb += (t7p_fb_t - t7p_fb) * sm_c; t7p_mix += (t7p_mix_t - t7p_mix) * sm_c;
    // its ap_chain, unrolled: 4 first-order all-passes per side, the feedback (soft limited) at the input
    a = t7p_aL; x = vx_l + t7p_fb * t7p_fl;
    y = a * x + t7p_l1 - a * t7p_m1; t7p_l1 = x; t7p_m1 = y; x = y;
    y = a * x + t7p_l2 - a * t7p_m2; t7p_l2 = x; t7p_m2 = y; x = y;
    y = a * x + t7p_l3 - a * t7p_m3; t7p_l3 = x; t7p_m3 = y; x = y;
    y = a * x + t7p_l4 - a * t7p_m4; t7p_l4 = x; t7p_m4 = y; yl = y;
    a = t7p_aR; x = vx_r + t7p_fb * t7p_fr;
    y = a * x + t7p_r1 - a * t7p_s1; t7p_r1 = x; t7p_s1 = y; x = y;
    y = a * x + t7p_r2 - a * t7p_s2; t7p_r2 = x; t7p_s2 = y; x = y;
    y = a * x + t7p_r3 - a * t7p_s3; t7p_r3 = x; t7p_s3 = y; x = y;
    y = a * x + t7p_r4 - a * t7p_s4; t7p_r4 = x; t7p_s4 = y; yr = y;
    t7p_fl = t7p_sat(yl); t7p_fr = t7p_sat(yr);
    fbc = sqrt(1 - t7p_fb * t7p_fb);
    yl *= fbc; yr *= fbc;
    !t7p_mode ? ( yl = t7p_sat(yl); yr = t7p_sat(yr); );   // the 90's grit (on the phased path)
    m = t7p_mix * t7p_w;
    vx_l = (1 - m) * vx_l + m * yl; vx_r = (1 - m) * vx_r + m * yr;
    // (the strip's own) the mix law's level loss made up, so the IN key and MIX leave the loudness alone (the phased
    // path is partly coherent with the voice: correlation 0.4, measured on the vocal test signal)
    m = 1 / sqrt(sqr(1 - m) + sqr(m) + 0.8 * m * (1 - m)); vx_l *= m; vx_r *= m;
    abs(t7p_m4) < 0.000000000001 && abs(t7p_s4) < 0.000000000001 ? (       // (denormals) a silent chain rests at 0
      t7p_l1 = t7p_l2 = t7p_l3 = t7p_l4 = t7p_m1 = t7p_m2 = t7p_m3 = t7p_m4 = 0;
      t7p_r1 = t7p_r2 = t7p_r3 = t7p_r4 = t7p_s1 = t7p_s2 = t7p_s3 = t7p_s4 = 0; t7p_fl = t7p_fr = 0;
    );
  );
);

// ---------- TAPE ECHO: the Echo engine of gfx-echofish.jsfx (GFX Echofish), its TAPE type ----------
// Its cubic tape read, its time glide (0.35 s: turning TIME bends the repeats), its wow (a drift, 2.5 ms deep at
// 100 %) and flutter (6.5 Hz +/-1.5 Hz, 0.22 ms), its loop: the LO CUT, the HI CUT (= TONE, 1.5 - 9 kHz), the tape's
// own roll-off and its anti-aliased tape saturation (ADAA, tanh(g x) / g with F = ln cosh(g x) / g^2) with the fixed
// shelf that makes up the half-sample average's droop; the right side a touch longer (its WIDTH 100 %). OB: a worn
// field machine (wow 35 %, flutter 25 %, DRIVE 45 %, lo cut 150 Hz, the tape at 6.5 kHz); CLEAN: an aligned studio
// machine (wow 10 %, flutter 8 %, DRIVE 15 %, lo cut 100 Hz, the tape at its 9 kHz). Here (the strip's): the record
// amp hears the voice and the repeats together (so the first repeat is already on tape), recorded at half level;
// the IN key fades the feed so the repeats ring out; DUCK on the return.
function t7e_rd(b, d) local(p, i, f, xm1, x0, x1, x2) (
  p = t7e_w - d; p < 0 ? p += T7E_N;
  i = floor(p); f = p - i;
  xm1 = b[(i + T7E_N - 1) & T7E_M]; x0 = b[i & T7E_M]; x1 = b[(i + 1) & T7E_M]; x2 = b[(i + 2) & T7E_M];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f + 0.5 * (x1 - xm1)) * f + x0);
);
function t7e_aaF(x) local(a) ( a = abs(x * t7e_g); (a + log(1 + exp(-2 * a)) - 0.69314718056) * t7e_ig2; );
// the record path, one side: its cuts, the tape's roll-off, its ADAA tape saturation, its droop shelf
function t7e_rec(x) instance(hpz, lz, l2, ax1, af1, ag) local(f, d) (
  hpz += (x - hpz) * t7e_loc; x -= hpz;
  lz += (x - lz) * t7e_hc; x = lz;
  l2 += (x - l2) * t7e_tpc; x = l2;
  ag != t7e_g ? ( ag = t7e_g; af1 = t7e_aaF(ax1); );          // a new curve: re-read
  f = t7e_aaF(x); d = x - ax1;
  d = abs(d) > 0.00001 ? (f - af1) / d : t7_tanh(0.5 * (x + ax1) * t7e_g) / t7e_g;
  ax1 = x; af1 = f;
  this.sh.bq_run(d);
);
function t7e_rclr() instance(hpz, lz, l2, ax1, af1) ( hpz = lz = l2 = ax1 = af1 = 0; this.sh.x1 = this.sh.x2 = this.sh.y1 = this.sh.y2 = 0; );
function t7e_set() local(k, q, ms) (
  t7e_on = slider36 >= 0.5;
  k = slider38 | 0;
  q = k == 1 ? 0.25 : k == 2 ? 1 / 3 : k == 3 ? 0.5 : k == 4 ? 0.75 : k == 5 ? 2 / 3 : k == 6 ? 1 : 1.5;
  ms = k == 0 ? slider37 : 60000 / max(tempo, 20) * q;
  t7e_ms = min(max(ms, 40), 2000);
  t7e_fb_t = slider40 / 100; t7e_lv_t = slider41 / 100;
  t7e_hc = vx_kf(1500 * 6 ^ (slider39 / 100));            // TONE: the loop's HI CUT, 1.5 - 9 kHz
  t7e_dk = slider42 / 100 * 15;                            // DUCK: up to 15 dB (the strip's)
  !eng ? ( t7e_wow = 0.35; t7e_flt = 0.25; t7e_loc = vx_kf(150); t7e_tpc = vx_kf(6500); )
       : ( t7e_wow = 0.10; t7e_flt = 0.08; t7e_loc = vx_kf(100); t7e_tpc = vx_kf(9000); );
  t7e_wow *= dm_a; t7e_flt *= dm_a; t7e_dspd = 0.3 * dm_s;
);
// the model's fixed parts (set at the silent point): its DRIVE
function t7e_modset() (
  t7e_g = 1 + 3 * (eng ? 0.15 : 0.45); t7e_ig2 = 1 / (t7e_g * t7e_g);
);
function t7e_clear() (
  memset(T7E_L, 0, T7E_N); memset(T7E_R, 0, T7E_N); t7eL.t7e_rclr(); t7eR.t7e_rclr();
);
function t7e_init() (
  t7e_tg = vx_kt(0.35); t7e_sm = vx_kt(0.02);
  t7eL.sh.bq_set(3, 0.3705 * srate, 0.4658, 15.673); t7eR.sh.bq_set(3, 0.3705 * srate, 0.4658, 15.673);
  t7e_modset(); t7e_set(); t7e_ts = t7e_ms * 0.001 * srate; t7e_fb = t7e_fb_t; t7e_lv = t7e_lv_t;
);
function t7e_run() local(md, dl, dr, el, er, g) (
  t7e_fw += (t7e_on - t7e_fw) * xs_c;
  !t7e_idle ? (
    t7e_fb += (t7e_fb_t - t7e_fb) * t7e_sm; t7e_lv += (t7e_lv_t - t7e_lv) * t7e_sm;
    t7e_ts += (t7e_ms * 0.001 * srate - t7e_ts) * t7e_tg;
    t7e_fph += (6.5 + 1.5 * t7e_vF) / srate; t7e_fph >= 1 ? t7e_fph -= 1;
    md = (t7e_wow * 0.0025 * t7e_vW + t7e_flt * 0.00022 * sin(2 * $pi * t7e_fph)) * srate;
    dl = min(max(t7e_ts + md, 3), T7E_N - 4); dr = min(max(t7e_ts * 1.03 + md, 3), T7E_N - 4);
    el = 2 * t7e_rd(T7E_L, dl); er = 2 * t7e_rd(T7E_R, dr);
    T7E_L[t7e_w] = t7eL.t7e_rec(0.5 * (vx_l * t7e_fw + t7e_fb * el) + vx_dn);
    T7E_R[t7e_w] = t7eR.t7e_rec(0.5 * (vx_r * t7e_fw + t7e_fb * er) + vx_dn);
    t7e_w = (t7e_w + 1) & T7E_M;
    // the return: MIX and DUCK
    du_g += (du_t - du_g) * du_gc;
    g = t7e_lv * du_g;
    vx_l += el * g; vx_r += er * g;
    t7e_pk = max(t7e_pk, abs(el) + abs(er));
  );
);

// ================= sample-rate setup: memory, coefficients =================
function vx_srinit() (
  vx_sr = srate; vx_mem = 1024;
  // the Series 74 mod + space (t7)
  T7E_N = vx_p2(2.1 * srate); T7E_M = T7E_N - 1; T7E_L = vx_alloc(T7E_N); T7E_R = vx_alloc(T7E_N); t7e_w = 0;
  pre_lc = vx_kf(110);
  xs_c = vx_kt(0.01);                                      // IN keys: 10 ms cross-fades
  sm_c = vx_kt(0.02);                                      // knob glides (per sample)
  dkr = 1 / (0.012 * srate);                               // MODEL / ORDER: 12 ms out, 12 ms in
  ms_c = vx_kt(0.003);                                     // FET colour: the running mean square
  op_dc = vx_kt(0.005);                                    // opto detector: RMS over 5 ms
  ds_at = vx_kt(0.0003); ds_rl = vx_kt(0.06);              // de-ess detector: 0.3 ms / 60 ms
  ds_rc = vx_kt(0.003);                                    // de-ess: the band against the whole, 3 ms
  du_at = vx_kt(0.012); du_rl = vx_kt(0.35);               // DUCK: the voice's envelope, 12 ms / 350 ms
  du_gc = vx_kt(0.006);
  vx_gb = 1;                                               // (the knob glides: set per block in @block - samplesblock is 0 in @init)
  ost_init(0);
  t7p_init(); t7e_init();
);

// ================= voicing (per block, from the current model eng) =================
// the pre-amp's and the saturation's make-up (dB) across DRIVE / AMOUNT 0, 25, 50, 75, 100 %: measured on the vocal
// test signal, so turning them up adds colour rather than loudness
function vx_tab(d, a, b, c, e, f) local(p, i, t) (
  p = min(max(d, 0), 1) * 4; i = min(floor(p), 3); t = p - i;
  i == 0 ? a + (b - a) * t : i == 1 ? b + (c - b) * t : i == 2 ? c + (e - c) * t : e + (f - e) * t;
);
// the opto's and the FET's make-up (dB): fitted on the vocal test signal so PEAK REDUCTION and AMOUNT change the
// amount of levelling far more than the loudness
function op_mkup(pr) ( eng ? pr * (-3.215 + pr * (16.977 - 4.483 * pr)) : pr * (-3.677 + pr * (27.191 - 8.781 * pr)); );
function fet_mkup(a, rt) local(d) (
  d = a / 24;
  rt == 0 ? vx_tab(d, 0.08, 1.67, 3.43, 6.61, 10.65) : rt == 1 ? vx_tab(d, 0.09, 1.97, 3.95, 7.59, 12.2) :
  rt == 2 ? vx_tab(d, 0.09, 2.01, 3.93, 7.7, 12.53) : vx_tab(d, 0.1, 2.03, 3.86, 7.71, 12.72);
);

// change detector (instance l)
function chg(v) instance(l) ( v != l ? ( l = v; 1; ) : 0; );
// a band's SHELF / BELL key: the band glides out (20 ms), changes shape at 0 dB (where both shapes are flat), glides back
function eqk(want) instance(ty, k) ( want != ty ? ( k = max(k - eq_kr, 0); k <= 0 ? ty = want; ) : k = min(k + eq_kr, 1); k; );
// the four bands (per block). OB (after CH74's OB EQ): coupled by transformers - proportional Q (the bells narrow
// as they are pushed), the low shelf with a little bump at its corner (Q 0.95), a soft high shelf (Q 0.55), and the
// neighbours load each other (a boosted LMF pulls the low shelf's corner up and eats a little of its gain, a boosted
// HMF pulls the high shelf's corner down). CLEAN: exact - the curves as set (Q as set, Butterworth shelves).
function vx_eq() local(lg, lf, lk, mg, mf, mq, hg, hf, hq, fg, ff, fk, q, g, f) (
  eq_kr = samplesblock / (0.02 * srate);
  lk = eLF.eqk(slider28 >= 0.5); fk = eHF.eqk(slider56 >= 0.5);
  lg = gd_lg.gl(slider26) * lk; lf = gd_lf.gl(slider27);
  mg = gd_mg.gl(slider10); mf = gd_mf.gl(slider9); mq = gd_mq.gl(slider11);
  hg = gd_hg.gl(slider51); hf = gd_hf.gl(slider52); hq = gd_hq.gl(slider53);
  fg = gd_fg.gl(slider54) * fk; ff = gd_ff.gl(slider55);
  vc_e1.chg(lg * 1.3 + lf * 0.0173 + eLF.ty * 7 + eng * 101 + (eng ? 0 : mg * 0.311)) ? (
    !eng ? ( f = lf * (1 + 0.25 * max(mg, 0) / 15); g = lg - 0.06 * mg; ) : ( f = lf; g = lg; );
    q = eLF.ty ? ( !eng ? 0.6 + abs(g) / 15 * 0.9 : 0.7 ) : ( !eng ? 0.95 : 0.70710678 );
    LP_.e1.bq_set(eLF.ty ? 2 : 4, f, q, g); RP_.e1.bq_set(eLF.ty ? 2 : 4, f, q, g);
  );
  vc_e2.chg(mg * 1.3 + mf * 0.0173 + mq * 7.1 + eng * 101 + (eng ? 0 : lg * 0.311)) ? (
    !eng ? ( g = mg - 0.04 * lg; q = mq * (0.6 + abs(g) / 15 * 0.9); ) : ( g = mg; q = mq; );
    LP_.e2.bq_set(2, mf, q, g); RP_.e2.bq_set(2, mf, q, g);
  );
  vc_e3.chg(hg * 1.3 + hf * 0.0173 + hq * 7.1 + eng * 101 + (eng ? 0 : fg * 0.311)) ? (
    !eng ? ( g = hg - 0.04 * fg; q = hq * (0.6 + abs(g) / 15 * 0.9); ) : ( g = hg; q = hq; );
    LP_.e3.bq_set(2, hf, q, g); RP_.e3.bq_set(2, hf, q, g);
  );
  vc_e4.chg(fg * 1.3 + ff * 0.0173 + eHF.ty * 7 + eng * 101 + (eng ? 0 : hg * 0.311)) ? (
    !eng ? ( f = ff * (1 - 0.15 * max(hg, 0) / 15); g = fg - 0.06 * hg; ) : ( f = ff; g = fg; );
    eHF.ty ? ( q = !eng ? 0.6 + abs(g) / 15 * 0.9 : 0.7; LP_.e4.bq_set(2, f, q, g); RP_.e4.bq_set(2, f, q, g); )
           : ( q = !eng ? 0.55 : 0.70710678; LP_.e4.bq_set(3, f, q, g); RP_.e4.bq_set(3, f, q, g); );
  );
);

function vx_voice() local(d, w, s, f, g, k) (
  // ---------- PREAMP ----------
  d = gd_pre.gl(slider6 / 100);
  pre_on_t = slider5 >= 0.5;
  !eng ? (
    // OB: the input iron, then a single-ended class-A stage (biased: one side gives first)
    pre_k = vx_db(-6 + 20 * d); pre_b = 0.2; pre_xa = 1.0 * d; pre_xd = 2 + 4 * d;
    PL.k.clp_set(2, 1, 1.5, 0); PR.k.clp_set(2, 1, 1.5, 0);
  ) : (
    // CLEAN: the balanced line driver: lots of headroom, then a symmetrical round-off; no iron (a trace)
    pre_k = vx_db(-12 + 18 * d); pre_b = 0; pre_xa = 0.1 * d; pre_xd = 1 + d;
    PL.k.clp_set(2, 1, 1, 0); PR.k.clp_set(2, 1, 1, 0);
  );
  PL.pf.clp_pf_block(d, srate, samplesblock); PR.pf.clp_pf_block(d, srate, samplesblock);
  w = pkt.clp_kt_block(d, srate, samplesblock); PL.k.clp_knee(w); PR.k.clp_knee(w);
  pre_mk_t = vx_db(!eng ? vx_tab(d, PM0, PM1, PM2, PM3, PM4) : vx_tab(d, PN0, PN1, PN2, PN3, PN4));
  pre_cb = PL.k.clp_crv(pre_b);
  pre_sl = pre_b <= PL.k.cp - w ? 1 : 1 - (pre_b - PL.k.cp + w) / (2 * w);
  PL.k.clp_tidy(); PR.k.clp_tidy();
  // the pre-amp's own colour, with DRIVE: OB the iron's low weight, CLEAN flat
  g = gd_pre.v;
  vc_pre.chg(g + 2 * eng) ? (
    !eng ? ( LP_.pe.bq_set(2, 140, 0.7, 1.4 * g); RP_.pe.bq_set(2, 140, 0.7, 1.4 * g); )
         : ( LP_.pe.bq_set(2, 3000, 0.7, 0); RP_.pe.bq_set(2, 3000, 0.7, 0); );
  );
  // ---------- LOW END ----------
  f = gd_hp.gl(slider7);
  vc_hp.chg(f) ? ( LP_.hp.bq_set(1, f, 0.70710678, 0); RP_.hp.bq_set(1, f, 0.70710678, 0); );
  g = gd_ls.gl(slider8);
  vc_ls.chg(g) ? ( LP_.ls.bq_set(4, 150, 0.70710678, g); RP_.ls.bq_set(4, 150, 0.70710678, g); );
  // ---------- OPTO ----------
  s = gd_op.gl(slider13 / 100);
  !eng ? (
    op_thr = -4 - 36 * s; op_sl = 1 - 1 / 3.5; op_kn = 12;
    op_at = vx_kt(0.010); op_rf = vx_kt(0.08); op_as = vx_kt(0.4); op_rs = vx_kt(2.5); op_sw = 0.65;
  ) : (
    op_thr = -4 - 30 * s; op_sl = 1 - 1 / 2.5; op_kn = 8;
    op_at = vx_kt(0.008); op_rf = vx_kt(0.06); op_as = vx_kt(0.5); op_rs = vx_kt(1.5); op_sw = 0.5;
  );
  op_mk_t = vx_db(op_mkup(s) + slider14);
  op_lin = 10 ^ ((op_thr - 0.5 * op_kn - 3) / 10);              // the detector's mean square at the knee's foot
  // ---------- DE-ESS ----------
  f = gd_df.gl(slider16);
  vc_df.chg(f) ? ( LP_.ds.dsx_set(1.2 * f); RP_.ds.dsx_set(1.2 * f); );
  ds_thr = slider17; ds_rng = slider18; ds_lin = 10 ^ ((ds_thr - 3) / 20);
  // ---------- FET ----------
  k = gd_fa.gl(slider21);
  fet_rt = slider22 | 0;
  fet_sl = fet_rt == 0 ? 0.75 : fet_rt == 1 ? 0.875 : fet_rt == 2 ? 0.9167 : 0.95;
  fet_thr = -6 - k; fet_lin = 10 ^ ((fet_thr - 1.5) / 20);
  fet_ac = vx_kt(min(max(slider23, 20), 800) * 0.000001);
  fet_rc = vx_kt(min(max(slider24, 50), 1100) * 0.001);
  fet_mk_t = vx_db(fet_mkup(k, fet_rt));
  fet_col = eng ? 0.18 : 0.5;                              // the FET's colour: OB the class-A FET, CLEAN cleaner
  // ---------- EQ: four bands, voiced by the model ----------
  vx_eq();
  // ---------- SATURATION ----------
  s = gd_sa.gl(slider29 / 100);
  sat_on_t = slider29 > 0.05;
  !eng ? (
    sat_k = vx_db(-8 + 20 * s); sat_b = 0.12;
    SL.k.clp_set(2, 1, 1.4, 0); SR.k.clp_set(2, 1, 1.4, 0);
  ) : (
    sat_k = vx_db(-10 + 20 * s); sat_b = 0;
    SL.k.clp_set(1, 1, 1, 0); SR.k.clp_set(1, 1, 1, 0);
  );
  SL.pf.clp_pf_block(s, srate, samplesblock); SR.pf.clp_pf_block(s, srate, samplesblock);
  w = skt.clp_kt_block(s, srate, samplesblock); SL.k.clp_knee(w); SR.k.clp_knee(w);
  sat_mk_t = vx_db(!eng ? vx_tab(s, SM0, SM1, SM2, SM3, SM4) : vx_tab(s, SN0, SN1, SN2, SN3, SN4));
  sat_cb = SL.k.clp_crv(sat_b);
  sat_sl = !eng ? ( sat_b <= SL.k.cp - w ? 1 : 1 - (sat_b - SL.k.cp + w) / (2 * w) ) : 1;
  SL.k.clp_tidy(); SR.k.clp_tidy();
  vc_sat.chg(s + 2 * eng) ? (
    !eng ? ( LP_.s1.bq_set(2, 100, 0.8, 1.5 * s); RP_.s1.bq_set(2, 100, 0.8, 1.5 * s);
             LP_.s2.bq_set(3, 9000, 0.6, -1.5 * s); RP_.s2.bq_set(3, 9000, 0.6, -1.5 * s); )
         : ( LP_.s1.bq_set(2, 100, 0.8, 0); RP_.s1.bq_set(2, 100, 0.8, 0);
             LP_.s2.bq_set(3, 9000, 0.6, 0); RP_.s2.bq_set(3, 9000, 0.6, 0); );
  );
  // ---------- the Series 74 mod + space ----------
  t7p_set(); t7e_set();
  // ---------- OUTPUT ----------
  out_t = vx_db(slider50) * (eng ? CLEAN_TRIM : 1);
);
// the model's fixed parts, set at the silent point of a swap
function vx_model() (
  !eng ? (
    PL.pf.clp_pf_cfg(22000, 7500, -1.0, 80);  PR.pf.clp_pf_cfg(22000, 7500, -1.0, 80);  pkt.clp_kt_cfg(0.55, 1.0);
    SL.pf.clp_pf_cfg(22000, 9000, -1.5, 90);  SR.pf.clp_pf_cfg(22000, 9000, -1.5, 90);  skt.clp_kt_cfg(0.55, 1.0);
  ) : (
    PL.pf.clp_pf_cfg(22000, 12000, -2.0, 120); PR.pf.clp_pf_cfg(22000, 12000, -2.0, 120); pkt.clp_kt_cfg(0.5, 0.9);
    SL.pf.clp_pf_cfg(22000, 11000, -1.5, 100); SR.pf.clp_pf_cfg(22000, 11000, -1.5, 100); skt.clp_kt_cfg(0.6, 1.0);
  );
  pkt.kti = 0; skt.kti = 0;
  vx_wf = eng ? 0.3 : 1;                                   // WANDER: OB the full amount, CLEAN a trace
  t7e_modset(); t7p_set(); t7p_clear(); t7p_cc = 0;
  vc_pre.l = vc_sat.l = vc_e1.l = vc_e2.l = vc_e3.l = vc_e4.l = -12345;
);

// ================= the stages (one sample, both sides: in vx_l / vx_r) =================

function st_lowcut() (
  vx_l = LP_.hp.bq_run(vx_l); vx_r = RP_.hp.bq_run(vx_r);
  vx_l = LP_.ls.bq_run(vx_l); vx_r = RP_.ls.bq_run(vx_r);
);
function st_eq() local(a, b) (
  eq_w += (eq_on_t - eq_w) * xs_c;
  eq_w > 0.000001 || eq_on_t ? (
    a = LP_.e4.bq_run(LP_.e3.bq_run(LP_.e2.bq_run(LP_.e1.bq_run(vx_l)))); b = RP_.e4.bq_run(RP_.e3.bq_run(RP_.e2.bq_run(RP_.e1.bq_run(vx_r))));
    vx_l += (a - vx_l) * eq_w; vx_r += (b - vx_r) * eq_w;
  );
);
function st_dyn() local(sc, t, e, g, a, b, gl_, y1, y2) (
  // ---- OPTO (stereo linked) ----
  op_w += (op_on_t - op_w) * xs_c;
  op_w > 0.000001 || op_on_t ? (
    sc = max(abs(vx_l), abs(vx_r));
    op_ms += (sc * sc - op_ms) * op_dc;
    // below the knee nothing is taken (the same result without the logarithm)
    t = op_ms <= op_lin ? 0 : -op_sl * dy_curve(10 * log10(op_ms + 0.0000000001) + 3 - op_thr, op_kn);
    op_ef += (t - op_ef) * (t < op_ef ? op_at : op_rf);
    op_es += (t - op_es) * (t < op_es ? op_as : op_rs);
    e = min(op_ef, op_es * op_sw);
    op_mk += (op_mk_t - op_mk) * sm_c;
    g = (e < -0.0000001 ? vx_db(e) : 1) * op_mk;
    vx_l *= 1 + (g - 1) * op_w; vx_r *= 1 + (g - 1) * op_w;
    op_grm = min(op_grm, e * op_w);
  ) : ( op_ef = op_es = op_ms = 0; );
  // ---- DE-ESS (split band, stereo linked) ----
  ds_w += (ds_on_t - ds_w) * xs_c; ds_lw += (ds_lis_t - ds_lw) * xs_c;
  ds_w > 0.000001 || ds_on_t ? (
    ds_pa = LP_.ds.dsx_run(vx_l); ds_pb = RP_.ds.dsx_run(vx_r); a = LP_.ds.hi; b = RP_.ds.hi;
    sc = max(abs(a), abs(b));
    ds_env += (sc - ds_env) * (sc > ds_env ? ds_at : ds_rl);
    // the band's power against the whole signal's (both sides): only sibilance stands out like this
    ds_mh += (a * a + b * b - ds_mh) * ds_rc; ds_mf += (vx_l * vx_l + vx_r * vx_r - ds_mf) * ds_rc;
    t = ds_env <= ds_lin || ds_mh <= 0.25118864 * ds_mf ? 0 :
        min(ds_rng, dy_curve(20 * log10(ds_env + 0.000000001) - ds_thr, 6) * 0.75) * min((10 * log10(ds_mh / ds_mf) + 6) * 0.25, 1);
    ds_gr += (t - ds_gr) * 0.5;
    g = ds_gr > 0.0000001 ? vx_db(-ds_gr) - 1 : 0;
    y1 = ds_pa + a * g; y2 = ds_pb + b * g;
    y1 += (a - y1) * ds_lw; y2 += (b - y2) * ds_lw;           // LISTEN: the detector's band
    vx_l = ds_pa + (y1 - ds_pa) * ds_w; vx_r = ds_pb + (y2 - ds_pb) * ds_w;
    ds_grm = max(ds_grm, ds_gr * ds_w);
  ) : ( vx_l = LP_.ds.dsx_apr(vx_l); vx_r = RP_.ds.dsx_apr(vx_r); ds_env = ds_gr = ds_mh = ds_mf = 0; );
  // ---- FET (stereo linked), its colour grows with the gain it takes away ----
  fet_w += (fet_on_t - fet_w) * xs_c;
  fet_w > 0.000001 || fet_on_t ? (
    sc = max(abs(vx_l), abs(vx_r));
    t = sc <= fet_lin ? 0 : -fet_sl * dy_curve(20 * log10(sc + 0.000001) - fet_thr, 3);
    fet_e += (t - fet_e) * (t < fet_e ? fet_ac : fet_rc);
    fet_mk += (fet_mk_t - fet_mk) * sm_c;
    g = fet_e < -0.0000001 ? vx_db(fet_e) : 1;
    gl_ = 1 - g; gl_ *= gl_ * fet_col;
    y1 = vx_l * g; y2 = vx_r * g;
    a = min(y1 * y1, 4); b = min(y2 * y2, 4);
    fet_m1 += (a - fet_m1) * ms_c; fet_m2 += (b - fet_m2) * ms_c;
    y1 = (y1 + gl_ * (a - fet_m1)) * fet_mk; y2 = (y2 + gl_ * (b - fet_m2)) * fet_mk;
    vx_l += (y1 - vx_l) * fet_w; vx_r += (y2 - vx_r) * fet_w;
    fet_grm = min(fet_grm, fet_e * fet_w);
  ) : ( fet_e = fet_m1 = fet_m2 = 0; );
);

// ================= presets =================
// the whole unit apart from TRIM, GUARD and WANDER
function vx_dflt() (
  slider1 = 0; slider2 = 0; slider5 = 1; slider6 = 30; slider7 = 60; slider8 = -2; slider9 = 300; slider10 = -2; slider11 = 0.8;
  slider12 = 1; slider13 = 35; slider14 = 0; slider15 = 1; slider16 = 4500; slider17 = -28; slider18 = 6; slider19 = 0;
  slider20 = 1; slider21 = 6; slider22 = 0; slider23 = 250; slider24 = 120; slider25 = 1; slider26 = 0; slider27 = 100; slider28 = 0;
  slider29 = 25; slider30 = 0; slider31 = 0.25; slider32 = 60; slider33 = 20; slider34 = 40; slider35 = 1; slider43 = 50;
  slider36 = 1; slider37 = 320; slider38 = 0; slider39 = 40; slider40 = 25; slider41 = 18; slider42 = 50; slider50 = 0;
  slider51 = 2; slider52 = 3000; slider53 = 0.8; slider54 = -1.5; slider55 = 10000; slider56 = 0;
);
// short setters: front end (model, drive, hpf, shelf), dynamics (opto pr, opto gain, de-ess freq, thr, range, fet amount,
// ratio, attack, release), EQ (order; LF gain, freq, bell; LMF gain, freq, Q; HMF gain, freq, Q; HF gain, freq, bell),
// saturation, phaser, tape echo, output
function p_fe(m, dr, hp, ls) ( slider1 = m; slider6 = dr; slider7 = hp; slider8 = ls; );
function p_dy(pr, og, df, dt, dg, fa, fr, fat, frl) ( slider13 = pr; slider14 = og; slider16 = df; slider17 = dt; slider18 = dg; slider21 = fa; slider22 = fr; slider23 = fat; slider24 = frl; );
function p_eq(od, lg, lf, lb, mg, mf, mq, hg, hf, hq, fg, ff, fb) (
  slider2 = od; slider26 = lg; slider27 = lf; slider28 = lb; slider10 = mg; slider9 = mf; slider11 = mq;
  slider51 = hg; slider52 = hf; slider53 = hq; slider54 = fg; slider55 = ff; slider56 = fb;
);
function p_sat(s) ( slider29 = s; );
function p_ph(on, rt, ce, dp, fb, mx, st) ( slider30 = on; slider31 = rt; slider43 = ce; slider32 = dp; slider33 = fb; slider34 = mx; slider35 = st; );
function p_ec(on, t, sy, tn, fb, mx, dk) ( slider36 = on; slider37 = t; slider38 = sy; slider39 = tn; slider40 = fb; slider41 = mx; slider42 = dk; );
function p_ou(ou) ( slider50 = ou; );
#vx_pm = "Init|OB Field Interview|OB Phased Lead|OB Tape Echo Lead|OB Stacked Harmonies|OB Gritty Rock Vocal|Clean Broadcast Voice|Clean Pop Lead|Clean Echo Ballad|Clean Phased Doubles|Clean Spoken Word|Clean Remote Hybrid";
function load_preset(p) local(k) (
  vx_dflt();
  p == 1  ? ( p_ou(0); ) :
  p == 2  ? ( p_fe(0, 25, 80, -3); p_dy(45, 0, 4760, -30, 6, 6, 0, 250, 120); p_eq(0, 0, 100, 0, -2.5, 280, 1, 3, 2600, 0.9, -2, 9000, 0); p_sat(20);
              p_ec(0, 320, 0, 40, 25, 18, 50); p_ou(-0.05); ) :
  p == 3  ? ( p_fe(0, 35, 60, -2); p_dy(40, 0, 4550, -28, 6, 6, 0, 250, 120); p_eq(0, 1, 120, 0, -1.5, 320, 0.8, 2.5, 3200, 0.8, -1, 10000, 0); p_sat(30);
              p_ph(1, 0.2, 50, 60, 30, 40, 1); p_ec(1, 340, 0, 35, 20, 14, 55); p_ou(-0.34); ) :
  p == 4  ? ( p_fe(0, 40, 70, -2); p_dy(40, 0, 4760, -28, 6, 8, 0, 200, 110); p_eq(0, 0, 100, 0, -2, 300, 1, 3, 3400, 1, 1, 11000, 0); p_sat(35);
              p_ec(1, 380, 0, 45, 38, 24, 60); p_ou(-1.10); ) :
  p == 5  ? ( p_fe(0, 25, 80, -3); p_dy(55, 0, 4900, -32, 8, 8, 1, 300, 160); p_eq(0, -2, 150, 0, -3, 320, 1.2, 1.5, 3000, 0.8, -3, 8000, 0); p_sat(20);
              p_ph(1, 0.08, 40, 45, 10, 25, 1); p_ec(1, 0, 6, 30, 15, 12, 50); p_ou(0.04); ) :
  p == 6  ? ( p_fe(0, 70, 70, -2); p_dy(35, 0, 4900, -26, 6, 12, 1, 120, 90); p_eq(0, 1.5, 120, 0, -2, 400, 1.2, 4, 2500, 1, 0, 10000, 0); p_sat(60);
              p_ec(1, 120, 0, 30, 10, 20, 30); p_ou(-2.12); ) :
  p == 7  ? ( p_fe(1, 20, 80, -2.5); p_dy(40, 0, 4760, -30, 6, 6, 0, 250, 120); p_eq(0, 0, 100, 0, -2, 300, 0.8, 2, 3000, 0.8, 0, 10000, 0); p_sat(10);
              p_ec(0, 320, 0, 40, 25, 18, 50); p_ou(-0.26); ) :
  p == 8  ? ( p_fe(1, 30, 60, -2); p_dy(30, 0, 4900, -26, 6, 8, 0, 200, 120); p_eq(0, 1, 120, 0, -1.5, 400, 1.4, 3, 4000, 1, 3, 12000, 0); p_sat(25);
              p_ec(1, 0, 6, 55, 22, 15, 60); p_ou(-0.90); ) :
  p == 9  ? ( p_fe(1, 25, 60, -2); p_dy(35, 0, 4760, -28, 6, 6, 0, 250, 150); p_eq(1, 1.5, 150, 1, -2, 350, 1.4, 2, 3800, 1, 2.5, 11000, 0); p_sat(20);
              p_ec(1, 0, 7, 45, 40, 25, 70); p_ou(-0.36); ) :
  p == 10 ? ( p_fe(1, 30, 70, -2); p_dy(35, 0, 4760, -28, 6, 7, 0, 250, 130); p_eq(0, 0, 100, 0, -1.5, 300, 1, 2.5, 3500, 1, 2, 10000, 0); p_sat(25);
              p_ph(1, 0.12, 45, 70, -30, 45, 1); p_ec(1, 260, 0, 40, 15, 10, 50); p_ou(0.63); ) :
  p == 11 ? ( p_fe(1, 15, 80, -3); p_dy(45, 0, 5040, -32, 8, 5, 0, 300, 120); p_eq(0, -1, 150, 0, -2.5, 280, 1, 2, 3000, 0.8, -1, 9000, 0); p_sat(10);
              p_ec(0, 320, 0, 40, 25, 18, 50); p_ou(0.00); ) :
  p == 12 ? ( p_fe(1, 35, 70, -2); p_dy(40, 0, 4760, -28, 6, 7, 0, 250, 130); p_eq(0, 1, 120, 0, -1, 300, 0.9, 2.5, 3500, 1, 2, 10000, 0); p_sat(30);
              p_ph(1, 0.15, 55, 55, 25, 35, 1); p_ec(1, 0, 4, 40, 30, 18, 55); p_ou(-0.55); );
  p == 13 ? ( slider3 = 0; slider4 = 1; slider49 = 50; );
  k = 1; loop(56, (p == 13 || (k != 3 && k != 4 && k != 49)) ? ui_auto(k); k += 1; );
  pr_cur = p > 12 ? 1 : p;
);

// ================= start =================
// the make-up tables (dB at 0, 25, 50, 75, 100 %): pre-amp OB (PM) / CLEAN (PN), saturation OB (SM) / CLEAN (SN)
PM0 = 0.02; PM1 = 0.27; PM2 = 1.00; PM3 = 1.67; PM4 = 2.50;
PN0 = 0.02; PN1 = 0.14; PN2 = 0.34; PN3 = 0.71; PN4 = 1.45;
SM0 = 0;    SM1 = 0.28; SM2 = 0.81; SM3 = 1.64; SM4 = 2.26;
SN0 = 0;    SN1 = 0.17; SN2 = 0.45; SN3 = 0.92; SN4 = 1.66;
CLEAN_TRIM = 1.0575;                                         // CLEAN level matched to OB at Init (vocal test signal)
eng = slider1 >= 0.5; ord = slider2 >= 0.5;
vx_wf = eng ? 0.3 : 1;
vx_srinit();
in_init();
PL.k.clp_set(2, 1, 1.5, 0); PR.k.clp_set(2, 1, 1.5, 0); SL.k.clp_set(2, 1, 1.4, 0); SR.k.clp_set(2, 1, 1.4, 0);
PL.pf.clp_pf_reset(); PR.pf.clp_pf_reset(); SL.pf.clp_pf_reset(); SR.pf.clp_pf_reset();
ostL.ost_ch_init(); ostR.ost_ch_init();
dr_hA.drift_init(0.8 + rand(0.4)); dr_hB.drift_init(0.8 + rand(0.4)); dr_sA.drift_init(0.8 + rand(0.4)); dr_sB.drift_init(0.8 + rand(0.4));
sup_a = rand(2) - 1; sup_b = rand(2) - 1;                    // the two sides never quite match
t7p_dR.drift_init(0.8 + rand(0.5)); t7p_dD.drift_init(0.8 + rand(0.5)); t7p_dC.drift_init(0.8 + rand(0.5));
t7e_dW.drift_init(0.8 + rand(0.5)); t7e_dF.drift_init(0.8 + rand(0.5));
vx_model();
gd_pre.gl_set(slider6 / 100); gd_hp.gl_set(slider7); gd_ls.gl_set(slider8);
gd_lg.gl_set(slider26); gd_lf.gl_set(slider27); gd_mg.gl_set(slider10); gd_mf.gl_set(slider9); gd_mq.gl_set(slider11);
gd_hg.gl_set(slider51); gd_hf.gl_set(slider52); gd_hq.gl_set(slider53); gd_fg.gl_set(slider54); gd_ff.gl_set(slider55);
eLF.ty = slider28 >= 0.5; eLF.k = 1; eHF.ty = slider56 >= 0.5; eHF.k = 1;
gd_op.gl_set(slider13 / 100); gd_df.gl_set(slider16); gd_fa.gl_set(slider21);
gd_sa.gl_set(slider29 / 100);
drift_macro(slider49);
vx_voice();
op_mk = op_mk_t; fet_mk = fet_mk_t; out_g = out_t;
pre_kl = pre_kr = pre_sl_ = pre_sr_ = pre_k; pre_mk = pre_mk_t; sat_mk = sat_mk_t; sat_kl = sat_kr = sat_sl_ = sat_sr_ = sat_k;
t7p_init(); t7e_init();
pre_w = pre_on_t; op_w = slider12 >= 0.5; ds_w = slider15 >= 0.5; fet_w = slider20 >= 0.5; eq_w = slider25 >= 0.5;
sat_w = sat_on_t; t7p_w = t7p_on; t7e_fw = t7e_on;
dk = 1; dst = 0; du_g = 1; vx_dn = 0.000000000000000001;
ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 0; pr_cur = 1; );
ui_dflt = 1;

@slider
0;

@block
srate != vx_sr ? ( vx_srinit(); in_init(); vx_model(); );
in_setup(slider3, slider4 >= 0.5);
drift_macro(slider49);
// WANDER: the heat (pre-amp, saturation) and the tape's wow / flutter here; the phaser's rate / width / centre in t7p_ctl
vx_di = dm_s * samplesblock / srate;
dr_hA.drift_tick(0.15 * vx_di); dr_hB.drift_tick(0.11 * vx_di); dr_sA.drift_tick(0.13 * vx_di); dr_sB.drift_tick(0.09 * vx_di);
// a MODEL or ORDER change: duck, swap at the silent point, fade back in (the voicing is rebuilt in the gap)
dst == 0 && ((slider1 >= 0.5) != eng || (slider2 >= 0.5) != ord) ? dst = 1;
dst == 2 ? ( vx_model(); dst = 3; );
op_on_t = slider12 >= 0.5; ds_on_t = slider15 >= 0.5; ds_lis_t = slider19 >= 0.5; fet_on_t = slider20 >= 0.5; eq_on_t = slider25 >= 0.5;
vx_gb = 1 - exp(-max(samplesblock, 1) / (0.03 * srate));   // the knob glides (30 ms), from this block's length
vx_voice();
t7e_vW = t7e_dW.drift_tick(t7e_dspd * samplesblock / srate); t7e_vF = t7e_dF.drift_tick(3 * t7e_dspd * samplesblock / srate);
// per side: the heat's wander (WANDER) on the pre-amp and the saturation (CLEAN: a trace)
pre_kl = pre_k * (1 + dm_a * vx_wf * (0.05 * dr_hA.v + 0.015 * sup_a)); pre_kr = pre_k * (1 + dm_a * vx_wf * (0.05 * dr_hB.v + 0.015 * sup_b));
sat_kl = sat_k * (1 + dm_a * vx_wf * (0.05 * dr_sA.v + 0.015 * sup_b)); sat_kr = sat_k * (1 + dm_a * vx_wf * (0.05 * dr_sB.v + 0.015 * sup_a));
// the duck's target from the voice's envelope (per block)
du_lv = 20 * log10(du_env + 0.0000001);
du_t = vx_db(-t7e_dk * min(max((du_lv + 42) / 18, 0), 1));
// meters (mailboxes: raised here, read and cleared on the panel)
mb_op = min(mb_op, op_grm); mb_fet = min(mb_fet, fet_grm); mb_ds = max(mb_ds, ds_grm); mb_du = min(mb_du, 20 * log10(du_g + 0.000001) * t7e_fw);
op_grm = 0; fet_grm = 0; ds_grm = 0;
mb_fc = t7p_fc;
// housekeeping (denormals)
abs(op_ms) < 0.000000000001 ? op_ms = 0; abs(ds_env) < 0.000000000001 ? ds_env = 0; abs(du_env) < 0.000000000001 ? du_env = 0;
abs(fet_m1) < 0.000000000001 ? fet_m1 = 0; abs(fet_m2) < 0.000000000001 ? fet_m2 = 0;
// the echo idle: once the feed is off and the tail has died away, stop running it
t7e_idle = !t7e_on && t7e_fw < 0.000001 && t7e_pk < 0.000001; t7e_pk = 0;
t7e_idle && !t7e_clr ? ( t7e_clear(); t7e_clr = 1; ); !t7e_idle ? t7e_clr = 0;
ost_setup(0, 0, 120, 6000, -0.3, 1);                  // the house output stage: CLIP always on (a character unit), no band SAT
pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = 0;        // no latency

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
in_process(spl0, spl1);
vx_dn = -vx_dn;
vx_l = in_l + vx_dn; vx_r = in_r + vx_dn;
pk_in = max(pk_in, max(abs(in_l), abs(in_r)));

// ---------- PREAMP ----------
pre_w += (pre_on_t - pre_w) * xs_c;
pre_w > 0.000001 || pre_on_t ? (
  pre_sl_ += (pre_kl - pre_sl_) * sm_c; pre_sr_ += (pre_kr - pre_sr_) * sm_c;     // the drive glides per sample
  pre_mk += (pre_mk_t - pre_mk) * sm_c;
  pr_a = PL.pre_run(LP_.pe.bq_run(vx_l), pre_sl_) * pre_mk; pr_b = PR.pre_run(RP_.pe.bq_run(vx_r), pre_sr_) * pre_mk;
  vx_l += (pr_a - vx_l) * pre_w; vx_r += (pr_b - vx_r) * pre_w;
);
// ---------- LOW END ----------
st_lowcut();
// ---------- EQ / DYNAMICS in the chosen order ----------
ord ? ( st_eq(); st_dyn(); ) : ( st_dyn(); st_eq(); );
// ---------- SATURATION ----------
sat_w += (sat_on_t - sat_w) * xs_c;
sat_w > 0.000001 || sat_on_t ? (
  sat_sl_ += (sat_kl - sat_sl_) * sm_c; sat_sr_ += (sat_kr - sat_sr_) * sm_c;
  sat_mk += (sat_mk_t - sat_mk) * sm_c;
  pr_a = SL.sat_run(LP_.s2.bq_run(LP_.s1.bq_run(vx_l)), sat_sl_) * sat_mk; pr_b = SR.sat_run(RP_.s2.bq_run(RP_.s1.bq_run(vx_r)), sat_sr_) * sat_mk;
  vx_l += (pr_a - vx_l) * sat_w; vx_r += (pr_b - vx_r) * sat_w;
);
// the voice's envelope for DUCK (before the effects)
du_x = max(abs(vx_l), abs(vx_r));
du_env += (du_x - du_env) * (du_x > du_env ? du_at : du_rl);

// ---------- the Series 74 mod + space: PHASER, TAPE ECHO (rings out when switched out; DUCK on its return) ----------
t7p_run();
t7e_run();

// ---------- MODEL / ORDER change: duck, swap at the silent point, fade back in ----------
dst == 1 ? ( dk -= dkr; dk <= 0 ? ( dk = 0; eng = slider1 >= 0.5; ord = slider2 >= 0.5; dst = 2; ); ) :
dst == 3 ? ( dk += dkr; dk >= 1 ? ( dk = 1; dst = 0; ); );
dst ? ( dkg = dk * dk * (3 - 2 * dk); vx_l *= dkg; vx_r *= dkg; );

// ---------- OUTPUT: level, the house output stage (CLIP always on) ----------
out_g += (out_t - out_g) * sm_c;
vx_l = ostL.ost_band(vx_l * out_g); vx_r = ostR.ost_band(vx_r * out_g);
ost_out(vx_l, vx_r);
spl0 = ost_l; spl1 = ost_r;
pk_out = max(pk_out, max(abs(spl0), abs(spl1)));

@gfx 1200 600
ui_begin(1200, 600);

// =====================================================================================================================
// the faceplate: Series 74 (gfx-s74 parts: the dark-steel case, the hazard-orange 74 plate, hard-edged modules with
// a header strip and four hex screws, cast pointer knobs with the house colour code, square lens keys, backlit
// edgewise meters, the desk fader). The model sets the modules as every Series 74 unit does: OB olive drab with
// amber lamps; CLEAN the light-grey broadcast desk with red-lit keys and cream windows.
// The modules run left to right in signal order: the top row, then the bottom row.
// =====================================================================================================================
// a module's IN key: one square lens, lit when in
function g7_in(x, y, idx) ( s74_lens(x, y, 40, 18, slider(idx) >= 0.5, "IN") ? s74_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
function g7_key(x, y, w, h, idx, s) ( s74_lens(x, y, w, h, slider(idx) >= 0.5, s) ? s74_set(idx, slider(idx) >= 0.5 ? 0 : 1); );
// a read-out window: a black bezel, the lamp-coloured legend
function g7_lcd(x, y, w, h, s) (
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  ui_col(s74_m ? 0x1A1514 : 0x1E1609); s74_r(x + 3, y + 3, w - 6, h - 6);
  ui_cola(0xFFFFFF, 0.05); s74_r(x + 3, y + 3, w - 6, (h - 6) * 0.45);
  gfx_setfont(13); ui_col(S74_LAMP); s74_t(x + 10, y + h * 0.5 - 6.5, s);
);
// a drop-down in a black housing: the current item in the lamp colour, an arrow; a click opens the list
function g7_drop(x, y, w, h, idx, menu) local(hov, i, n, cur) (
  hov = s74_hov(x, y, w, h); n = pk_pcount(menu); cur = slider(idx) | 0;
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  ui_col(hov ? 0x2E2A24 : s74_m ? 0x1A1514 : 0x1E1609); s74_r(x + 3, y + 3, w - 6, h - 6);
  gfx_setfont(13); ui_col(S74_LAMP); pk_pitem(menu, cur + 1, #g7_di); s74_t(x + 10, y + h * 0.5 - 6.5, #g7_di);
  gfx_triangle((x + w - 18) * sc, (y + h * 0.5 - 3) * sc, (x + w - 8) * sc, (y + h * 0.5 - 3) * sc, (x + w - 13) * sc, (y + h * 0.5 + 3) * sc);
  hov && pressed && drag_id == 0 ? (
    drag_id = -1;
    strcpy(#g7_dm, ""); i = 1;
    loop(n, i == cur + 1 ? strcat(#g7_dm, "!"); strcat(#g7_dm, pk_pitem(menu, i, #g7_dt)); i < n ? strcat(#g7_dm, "|"); i += 1; );
    gfx_x = x * sc; gfx_y = (y + h) * sc; i = gfx_showmenu(#g7_dm); i > 0 ? s74_set(idx, i - 1);
  );
);
// a gain-reduction meter (gfx-s74's edgewise GR meter with a sparser scale, 0 / 4 / 10 / 20 dB, for the narrow modules)
function g7_gredge(x, y, w, h, gr, label) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  tgt = s74_grpos(gr); !g7_ok ? pos = tgt;                // (opens at rest, no swing in)
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.02), 1.02);
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  wx = x + 5; ww = w - 10;
  ui_col(S74_LAMPD); s74_r(wx, y + 5, ww, h - 10);
  i = 0; loop(10, ui_cola(S74_LAMPW, 0.12); s74_r(wx + ww * 0.03 * i, y + 5 + i * 0.5, ww * (1 - 0.06 * i), h - 10 - i); i += 1; );
  i = 0;
  loop(8,
    d = i == 0 ? 0 : i == 1 ? 1 : i == 2 ? 2 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 10 : i == 6 ? 14 : 20;
    px = wx + 18 + (ww - 36) * s74_grpos(d);
    ui_col(S74_CHAR); s74_r(px, y + 8, 1.2, d == 0 || d == 10 || d == 20 ? 7 : 4);
    gfx_setfont(13);
    d == 0 || d == 4 || d == 10 || d == 20 ? ( sprintf(#g7_e, "%d", d); s74_tc(px, y + 24, #g7_e); );
    i += 1;
  );
  ui_cola(S74_CHAR, 0.8); s74_r(wx + 18, y + 8, ww - 36, 1);
  px = wx + 18 + (ww - 36) * pos;
  ui_col(S74_NDL); s74_r(px - 0.8, y + 6, 1.8, h - 12);
  gfx_setfont(13); ui_col(S74_CHAR); s74_tc(wx + ww * 0.5, y + h - 14, label);
  ui_cola(0xFFFFFF, 0.08); s74_r(wx, y + 5, ww, (h - 10) * 0.4);
);
// an edgewise level meter (gfx-s74's, with the -20 mark left unnumbered: the needle rests just left of it, so no
// numeral is crossed at rest)
function g7_edge(x, y, w, h, lvl, label) instance(pos, vel, lt) local(dt, tgt, i, d, px, wx, ww) (
  dt = min(max(time_precise() - lt, 0.001), 0.05); lt = time_precise();
  d = 20 * log10(max(lvl, 0.00001));
  tgt = min(max((d + 20) / 23, -0.04), 1.04); !g7_ok ? pos = tgt;
  vel += (150 * (tgt - pos) - 17 * vel) * dt; pos += vel * dt; pos = min(max(pos, -0.05), 1.05);
  ui_cola(0x000000, 0.4); s74_r(x + 1, y + 2, w, h);
  ui_col(0x101112); s74_r(x, y, w, h);
  wx = x + 5; ww = w - 10;
  ui_col(S74_LAMPD); s74_r(wx, y + 5, ww, h - 10);
  i = 0; loop(10, ui_cola(S74_LAMPW, 0.12); s74_r(wx + ww * 0.03 * i, y + 5 + i * 0.5, ww * (1 - 0.06 * i), h - 10 - i); i += 1; );
  i = 0;
  loop(8,
    d = i == 0 ? -20 : i == 1 ? -10 : i == 2 ? -7 : i == 3 ? -5 : i == 4 ? -3 : i == 5 ? 0 : i == 6 ? 1 : 3;
    px = wx + 22 + (ww - 44) * (d + 20) / 23;
    ui_col(d > 0 ? S74_RED : S74_CHAR); s74_r(px, y + 8, 1.2, d == 0 || d == -20 || d == 3 ? 7 : 4);
    gfx_setfont(13);
    d == -10 || d == -5 || d == 0 || d == 3 ? ( sprintf(#g7_e, d > 0 ? "+%d" : "%d", d); s74_tc(px, y + 24, #g7_e); );
    i += 1;
  );
  ui_cola(S74_CHAR, 0.8); s74_r(wx + 22, y + 8, (ww - 44) * 20 / 23, 1); ui_col(S74_RED); s74_r(wx + 22 + (ww - 44) * 20 / 23, y + 8, (ww - 44) * 3 / 23, 1);
  px = wx + 22 + (ww - 44) * pos;
  ui_col(S74_NDL); s74_r(px - 0.8, y + 6, 1.8, h - 12);
  gfx_setfont(13); ui_col(S74_CHAR); s74_tc(wx + ww * 0.5, y + h - 14, label);
  ui_cola(0xFFFFFF, 0.08); s74_r(wx, y + 5, ww, (h - 10) * 0.4);
);
function g7_hz(dst, f) ( f >= 1000 ? sprintf(dst, "%.2f kHz", f / 1000) : sprintf(dst, "%.0f Hz", f); );

// ---------- the modules (x, y = the module's top left) ----------
function m_pre(x, y) (
  s74_mod(x, y, 140, 276, "PREAMP"); g7_in(x + 80, y + 3, 5);
  s74_knob(x + 70, y + 92, 28, 6, 0, 100, 30, 0, "DRIVE", "%.0f%%", 0);
  s74_knob(x + 36, y + 190, 15, 3, -24, 12, 0, 0, "TRIM", "%+.1f dB", 0);
  g7_key(x + 68, y + 176, 60, 24, 4, "GUARD");
  pk_led((x + 98) * sc, (y + 214) * sc, 3.5 * sc, slider4 >= 0.5 && g_grd > 0.5, S74_HAZ);
  s74_smallc(x + 70, y + 248, g7_m ? "LINE DRIVER" : "IRON · CLASS A");
);
function m_low(x, y) (
  s74_mod(x, y, 104, 276, "LOW END");
  slider7 <= 20.5 ? strcpy(#s74_vs, "OFF") : sprintf(#s74_vs, "%.0f Hz", slider7);
  s74_kc = S74_C_HPF; s74_knob(x + 52, y + 80, 20, 7, 20, 80, 60, 0, "HIGH-PASS", "", 0);
  s74_kc = S74_C_LF; s74_knob(x + 52, y + 174, 20, 8, -3, 0, -2, 0, "SHELF", "%.1f dB", 0); s74_kc = 0;
  s74_smallc(x + 52, y + 248, "150 Hz SHELF");
);
function m_opto(x, y) (
  s74_mod(x, y, 150, 276, "OPTO"); g7_in(x + 90, y + 3, 12);
  s74_knob(x + 75, y + 72, 25, 13, 0, 100, 35, 0, "PEAK REDUCTION", "%.0f%%", 0);
  s74_knob(x + 75, y + 148, 15, 14, -10, 10, 0, 0, "GAIN", "%+.1f dB", 0);
  g7mO.g7_gredge(x + 10, y + 198, 130, 58, slider12 >= 0.5 ? -g_op : 0, "GR");
);
function m_dess(x, y) (
  s74_mod(x, y, 160, 276, "DE-ESS"); g7_in(x + 100, y + 3, 15);
  pk_led((x + 86) * sc, (y + 12) * sc, 3.5 * sc, slider15 >= 0.5 && g_ds > 1, S74_HAZ);
  g7_hz(#s74_vs, slider16); s74_kc = S74_C_HF; s74_knob(x + 42, y + 78, 19, 16, 4000, 10000, 4500, 1, "FREQ", "", 0); s74_kc = 0;
  s74_knob(x + 118, y + 78, 19, 17, -50, 0, -28, 0, "THRESH", "%.1f dB", 0);
  s74_knob(x + 42, y + 168, 16, 18, 0, 12, 6, 0, "RANGE", "%.1f dB", 0);
  g7_key(x + 88, y + 156, 62, 24, 19, "LISTEN");
  sprintf(#g7_v, "-%.1f dB", g_ds); s74_smallc(x + 119, y + 204, slider15 >= 0.5 ? #g7_v : "OUT");
  s74_smallc(x + 80, y + 244, "SPLIT BAND");
);
function m_fet(x, y) local(i) (
  s74_mod(x, y, 186, 276, "FET"); g7_in(x + 126, y + 3, 20);
  s74_knob(x + 48, y + 76, 24, 21, 0, 24, 6, 0, "AMOUNT", "%.1f dB", 0);
  i = 0; loop(4,
    s74_lens(x + 98 + (i % 2) * 42, y + 38 + floor(i / 2) * 30, 38, 24, (slider22 | 0) == i, i == 0 ? "4" : i == 1 ? "8" : i == 2 ? "12" : "20") ? s74_set(22, i);
    i += 1; );
  s74_cap(x + 137, y + 110, "RATIO");
  s74_knob(x + 50, y + 150, 15, 23, 20, 800, 250, 1, "ATTACK", "%.0f us", 0);
  s74_knob(x + 134, y + 150, 15, 24, 50, 1100, 120, 1, "RELEASE", "%.0f ms", 0);
  g7mF.g7_gredge(x + 10, y + 198, 166, 58, slider20 >= 0.5 ? -g_fet : 0, "GR");
);
// the EQ: four columns (LF, LMF, HMF, HF), each GAIN, FREQ and Q (LF / HF: their SHELF / BELL keys), in the band's colour
function g7_eqcol(cx, y, nm, cap, ig, iff, flo, fhi, fdf, iq, ik, gdf) (
  gfx_setfont(12); ui_col(g7_m ? ui_mix(cap, 0x000000, cap == S74_C_HPF ? 0.35 : 0) : cap == S74_C_LPF ? S74_INK : ui_mix(cap, 0xFFFFFF, 0.4)); s74_tc(cx, y + 38, nm);
  s74_kc = cap; s74_knob(cx, y + 80, 18, ig, -15, 15, gdf, 0, "GAIN", "%+.1f dB", 0);
  g7_hz(#s74_vs, slider(iff)); s74_kc = cap; s74_knob(cx, y + 158, 16, iff, flo, fhi, fdf, 1, "FREQ", "", 0);
  iq > 0 ? ( s74_kc = cap; s74_knob(cx, y + 230, 12, iq, 0.4, 4, 0.8, 1, "Q", "%.2f", 0); ) : (
    s74_lens(cx - 41, y + 218, 40, 22, slider(ik) < 0.5, "SHELF") ? s74_set(ik, 0);
    s74_lens(cx + 1, y + 218, 40, 22, slider(ik) >= 0.5, "BELL") ? s74_set(ik, 1);
  );
  s74_kc = 0;
);
function m_eq(x, y) (
  s74_mod(x, y, 376, 276, "EQ"); g7_in(x + 316, y + 3, 25);
  gfx_setfont(13); ui_col(S74_DIM); s74_t(x + 56, y + 6, g7_m ? "EXACT CURVES" : "BROADCAST · PROPORTIONAL Q");
  ui_cola(S74_INK, 0.18); s74_r(x + 96, y + 32, 1, 226); s74_r(x + 188, y + 32, 1, 226); s74_r(x + 280, y + 32, 1, 226);
  g7_eqcol(x + 50, y, "LF", S74_C_LF, 26, 27, 30, 450, 100, 0, 28, 0);
  g7_eqcol(x + 142, y, "LMF", S74_C_LMF, 10, 9, 120, 2000, 300, 11, 0, -2);
  g7_eqcol(x + 234, y, "HMF", S74_C_HMF, 51, 52, 600, 8000, 3000, 53, 0, 2);
  g7_eqcol(x + 326, y, "HF", S74_C_HF, 54, 55, 1500, 16000, 10000, 0, 56, -1.5);
);
function m_sat(x, y) (
  s74_mod(x, y, 150, 242, "SATURATION");
  s74_knob(x + 75, y + 100, 28, 29, 0, 100, 25, 0, "AMOUNT", "%.0f%%", 0);
  s74_smallc(x + 75, y + 176, g7_m ? "IC RAILS" : "IRON · CLASS A");
  s74_smallc(x + 75, y + 196, slider29 > 0.05 ? "" : "OUT");
);
function m_phs(x, y) (
  s74_mod(x, y, 350, 242, "PHASER"); g7_in(x + 290, y + 3, 30);
  g7_hz(#g7_f, g_fc);
  sprintf(#g7_v, "%s  ·  4 STAGES  ·  %s", g7_m ? "OPTO" : "90", #g7_f); g7_lcd(x + 14, y + 34, 322, 26, #g7_v);
  s74_knob(x + 46, y + 116, 18, 31, 0.02, 5, 0.25, 1, "RATE", "%.2f Hz", 0);
  s74_knob(x + 110, y + 116, 18, 43, 0, 100, 50, 0, "CENTRE", "%.0f%%", 0);
  s74_knob(x + 174, y + 116, 18, 32, 0, 100, 60, 0, "DEPTH", "%.0f%%", 0);
  s74_knob(x + 238, y + 116, 18, 33, -90, 90, 20, 0, "FEEDBACK", "%+.0f%%", 0);
  s74_knob(x + 302, y + 116, 18, 34, 0, 100, 40, 0, "MIX", "%.0f%%", 0);
  g7_key(x + 22, y + 184, 80, 24, 35, "STEREO");
  s74_smallc(x + 228, y + 196, g7_m ? "SINE · PHOTOCELL LAG" : "TRIANGLE · A LITTLE GRIT");
);
function m_echo(x, y) (
  s74_mod(x, y, 360, 242, "TAPE ECHO"); g7_in(x + 300, y + 3, 36);
  slider38 >= 0.5 ? sprintf(#g7_v, "%s  ·  SYNC %.0f MS", g7_m ? "STUDIO TAPE" : "FIELD TAPE", t7e_ms)
                  : sprintf(#g7_v, "%s  ·  %.0f MS", g7_m ? "STUDIO TAPE" : "FIELD TAPE", t7e_ms);
  g7_lcd(x + 14, y + 34, 332, 26, #g7_v);
  sprintf(#s74_vs, "%.0f ms", slider37);
  s74_off = slider38 >= 0.5; s74_knob(x + 52, y + 116, 18, 37, 60, 1000, 320, 1, "TIME", "", 0); s74_off = 0;
  g7_hz(#s74_vs, 1500 * 6 ^ (slider39 / 100)); s74_kc = S74_C_LPF; s74_knob(x + 136, y + 116, 18, 39, 0, 100, 40, 0, "TONE", "", 0); s74_kc = 0;
  s74_knob(x + 220, y + 116, 18, 40, 0, 100, 25, 0, "FEEDBACK", "%.0f%%", 0);
  s74_knob(x + 304, y + 116, 18, 41, 0, 100, 18, 0, "MIX", "%.0f%%", 0);
  s74_cap(x + 62, y + 172, "SYNC");
  g7_drop(x + 16, y + 184, 96, 26, 38, "FREE|1/16|1/8 T|1/8|1/8 D|1/4 T|1/4|1/4 D");
  sprintf(#s74_vs, "%.0f%%  (%.1f dB)", slider42, slider42 * 0.15); s74_knob(x + 152, y + 190, 17, 42, 0, 100, 50, 0, "DUCK", "", 0);
  g7mD.g7_gredge(x + 196, y + 158, 150, 58, slider36 >= 0.5 ? -g_du : 0, "DUCK");
);
function m_out(x, y) (
  s74_mod(x, y, 276, 242, "OUTPUT");
  s74_knob(x + 46, y + 64, 17, 49, 0, 100, 50, 0, "WANDER", "%.0f%%", 0);
  s74_smallc(x + 132, y + 64, "CLIP · ALWAYS ON");
  pk_led((x + 132) * sc, (y + 84) * sc, 4 * sc, g_clp, S74_HAZ);
  g7mI.g7_edge(x + 14, y + 108, 170, 56, g_pi * 2.83, "IN");
  g7mU.g7_edge(x + 14, y + 168, 170, 56, g_po * 2.83, "OUT");
  s74_fader(x + 230, y + 46, 140, 50, -12, 12, 0, 0, "OUTPUT", "%+.1f dB", 0);
);

// ---------- the frame ----------
g7_m = slider1 >= 0.5;
s74_pal(g7_m);
s74_fonts();
s74_face(1200, 600);
// the panel's mailboxes, read and cleared here
g_op = min(mb_op, g_op * 0.8); mb_op = 0;
g_fet = min(mb_fet, g_fet * 0.8); mb_fet = 0;
g_ds = max(mb_ds, g_ds * 0.8); mb_ds = 0;
g_du = min(mb_du, g_du * 0.85); mb_du = 0;
g_pi = max(pk_in, g_pi * 0.8); pk_in = 0;
g_po = max(pk_out, g_po * 0.8); pk_out = 0;
g_clp = ost_clipped; ost_clipped = 0;
g_grd = in_grd; in_grd = 0;
g_fc = mb_fc;

// ---------- the header: the 74 plate, the name, the small print, presets, ORDER, the MODEL keys, the size picker ----------
ui_col(S74_HAZ); s74_r(16, 13, 30, 28);
gfx_setfont(15); ui_col(0x16181A); s74_tc(31, 27, "74");
gfx_setfont(14); ui_col(0xE9E6D6); gfx_measurestr("STR74", g7_tw, g7_th); gfx_x = 56 * sc; gfx_y = 13 * sc - g7_th * 0.17; gfx_drawstr("STR74");
g7_sx = 56 + g7_tw / sc + 14;
gfx_setfont(13); ui_col(0xA9A98E); s74_t(g7_sx, 15, "SERIES 74"); s74_t(g7_sx, 29, g7_m ? "VOCAL STRIP · CLEAN" : "VOCAL STRIP · OB");
pk_pextra = "Reset all to defaults";
gk_ = pk_preset(300 * sc, 10 * sc, 384 * sc, 34 * sc, pr_cur, #vx_pm);
gk_ > 0 ? load_preset(gk_);
g7ok.s74_orderkey(704, 15, 170, 24, slider2 >= 0.5 ? "EQ > DYNAMICS" : "DYNAMICS > EQ") ? s74_set(2, slider2 >= 0.5 ? 0 : 1);
s74_modelkeys(970, 14, 1);
ui_size_picker(1116 * sc, 18 * sc);

// ---------- the top row: PREAMP, LOW END, then the EQ and the dynamics in the chosen order ----------
g7_o = slider2 >= 0.5;
m_pre(20, 62);
m_low(168, 62);
m_eq(g7_o ? 280 : 800, 62);
m_opto(g7_o ? 664 : 280, 62);
m_dess(g7_o ? 822 : 438, 62);
m_fet(g7_o ? 990 : 606, 62);
// ---------- the bottom row: SATURATION, PHASER, TAPE ECHO, OUTPUT ----------
m_sat(20, 346);
m_phs(178, 346);
m_echo(536, 346);
m_out(904, 346);
g7_ok = 1;

pk_end();
ui_end();
