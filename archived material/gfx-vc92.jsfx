// ---------- OUTPUT: the voice ladder, TRIM, DRIFT, SAT, GUARD; MIX and OUTPUT on faders ----------
s92_mod(710, 62, 230, 292, "OUTPUT");
v9mI.s92_edge(722, 92, 206, 46, v9a_vi * 2.83, "VOICE");
v9a_vi *= 0.6;
