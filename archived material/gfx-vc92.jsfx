    ui_col(S92_LAMP); s92_r(gx_ + 8 + gi_ * gb_ + 1, gy_ + 82 - 72 * gv_, gb_ - 2, 72 * gv_);
  );
  gi_ += 1; );
gfx_setfont(13); ui_col(S92_LCDT);
s92_t(gx_ + 9, gy_ + 88, "100"); s92_tc(gx_ + 8 + (gw_ - 16) * 0.528, gy_ + 95, "1k"); s92_t(gx_ + gw_ - 26, gy_ + 88, "8k");
s92_knob(340, 260, 18, 10, -12, 12, 0, 0, "FORMANT", "%+.1f st", 0);
s92_knob(418, 260, 18, 11, 0.5, 50, 4, 1, "ATTACK", "%.1f ms", 0);
s92_knob(496, 260, 18, 12, 10, 500, 60, 1, "RELEASE", "%.0f ms", 0);
